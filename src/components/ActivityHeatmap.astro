---
import type { Language } from '../data/site';
import type { ActivitySnapshot, ActivitySource } from '../lib/activity';
import { renderActivityChart } from '../lib/activity-markup';
interface Props { source: ActivitySource; snapshot: ActivitySnapshot | null; lang: Language; years: number[]; asOf: string }
const { source, snapshot, lang, asOf } = Astro.props;
---
<Fragment set:html={renderActivityChart(source, snapshot, lang, asOf)} />
<script>
  import '../scripts/activity';
</script>
