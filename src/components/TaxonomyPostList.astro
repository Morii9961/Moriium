---
import type { CollectionEntry } from 'astro:content';
import { UI, type Language } from '../data/site';
import { formatDate, postPath } from '../utils/content';

type Entry = CollectionEntry<'posts'> | CollectionEntry<'protected'>;

interface Props {
  posts: Entry[];
  lang: Language;
  heading: string;
  countLabel: string;
  tagsLabel: string;
}

const { posts, lang, heading, countLabel, tagsLabel } = Astro.props;
const ui = UI[lang];
---

<section class="a-taxonomy-detail" aria-labelledby="taxonomy-posts-title">
  <header class="a-taxonomy-detail__head">
    <h2 id="taxonomy-posts-title">{heading}</h2>
    <p>{countLabel}</p>
  </header>
  <ol class="a-taxonomy-posts">
    {posts.map((post) => (
      <li>
        <a href={postPath(post)}>
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, ui.locale)}</time>
          <div class="a-taxonomy-posts__copy">
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
          </div>
          <p class="a-taxonomy-posts__tags"><span>{tagsLabel}</span>{post.data.tags.join(' · ') || '—'}</p>
          <span class="a-taxonomy-posts__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>
