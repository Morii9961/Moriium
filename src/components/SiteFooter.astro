---
/*
 * DESIGN.md 8.5: the footer concludes the site rather than restarting it. Three
 * quiet columns — who this is, where else to go, what the terms are — and no
 * second navigation of everything already in the masthead.
 */
import { SITE, UI, type Language } from '../data/site';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const ui = UI[lang];
---

<footer class="site-footer">
  <div class="measure measure--wide site-footer__inner">
    <div class="site-footer__identity">
      <p class="site-footer__name" translate="no">{SITE.name}</p>
      <p>{ui.footer.description}</p>
    </div>
    <nav aria-label={ui.footerNav}>
      <a href={`/${lang}/writing/`}>{ui.nav.writing}</a>
      <a href={`/${lang}/archive/`}>{ui.nav.archive}</a>
      <a href={`/${lang}/categories/`}>{ui.nav.categories}</a>
      <a href={`/${lang}/about/`}>{ui.nav.about}</a>
      <a href={`/${lang}/rss.xml`}>RSS</a>
    </nav>
    <p class="site-footer__rights">
      © {new Date().getFullYear()} {SITE.author}<br />{ui.footer.rights}
    </p>
  </div>
</footer>
