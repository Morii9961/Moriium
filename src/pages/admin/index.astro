---
// The author admin is the only client entry allowed to load Vue and Tiptap.
// Public routes stay prerendered and scripts/check-render-split.mjs rejects an
// admin bundle leaking into their files.
export const prerender = false;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>Moriium Admin</title>
  </head>
  <body>
    <div data-moriium-admin>
      <noscript>作者后台需要 JavaScript 才能编辑文章。</noscript>
    </div>
    <script src="../../admin/main.ts"></script>
  </body>
</html>
