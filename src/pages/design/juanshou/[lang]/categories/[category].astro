---
import type { GetStaticPaths } from 'astro';
import JuanshouBase from '../../../../../layouts/JuanshouBase.astro';
import { SITE, type Language } from '../../../../../data/site';
import { COPY, jsDay, jsPath } from '../../../../../data/juanshou';
import { getListedPosts, type Post, type ProtectedPost } from '../../../../../utils/content';
import { jsEntryHref } from '../../../../../utils/juanshou';

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const lang of SITE.languages) {
    const posts = await getListedPosts(lang);
    for (const category of new Set(posts.map((post) => post.data.category))) {
      paths.push({
        params: { lang, category },
        props: { lang, category, posts: posts.filter((post) => post.data.category === category) },
      });
    }
  }
  return paths;
};

const { lang, category, posts } = Astro.props as {
  lang: Language;
  category: string;
  posts: Array<Post | ProtectedPost>;
};
const c = COPY[lang];
---

<JuanshouBase lang={lang} title={`${category} · ${c.nav.categories}`} section="categories">
  <div class="js-page">
    <section class="js-section" aria-labelledby="js-category">
      <div class="js-opener">
        <h2 id="js-category">{category}</h2>
        <p class="js-note"><a href={jsPath(lang, 'categories')}>{c.nav.categories} →</a></p>
        <p class="js-opener__say">{posts.length} {c.count}</p>
      </div>

      <ol class="js-index">
        {posts.map((post) => (
          <li>
            <p class="js-index__meta js-note">
              <time datetime={post.data.publishedAt.toISOString()}>{jsDay(post.data.publishedAt)}</time>
              {post.data.tags.map((tag) => <a href={jsPath(lang, 'tags', tag)}>#{tag}</a>)}
            </p>
            <h3 class="js-index__title"><a href={jsEntryHref(post)}>{post.data.title}</a></h3>
            <p class="js-index__summary">{post.data.summary}</p>
          </li>
        ))}
      </ol>
      <p class="js-note js-back"><a href={jsPath(lang, 'writing')}>{c.backToWriting}</a></p>
    </section>
  </div>
</JuanshouBase>
