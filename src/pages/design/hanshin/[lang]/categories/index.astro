---
import type { GetStaticPaths } from 'astro';
import HanshinBase from '../../../../../layouts/HanshinBase.astro';
import { SITE, UI, type Language } from '../../../../../data/site';
import { HANSHIN, hsCount, hsDay, hsPath } from '../../../../../data/hanshin';
import { getListedPosts } from '../../../../../utils/content';
import { hsEntryHref } from '../../../../../utils/hanshin';

export const getStaticPaths: GetStaticPaths = () =>
  SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const c = HANSHIN[lang];
const posts = await getListedPosts(lang);
const categories = hsCount(posts, (post) => [post.data.category]);
---

<HanshinBase lang={lang} title={c.nav.categories} section="categories">
  <div class="hs-flow hs-plate">
    <section class="hs-opening">
      <p class="hs-note hs-note--latin hs-opening__label">Categories</p>
      <h1>{c.nav.categories}</h1>
      <p class="hs-opening__lead">{c.categoriesNote}</p>
    </section>

    <hr class="hs-divider" />

    <section class="hs-section u-media" aria-label={c.nav.categories}>
      {categories.length > 0 ? (
        categories.map((category) => (
          <>
            <div class="hs-year">
              <h2><a href={hsPath(lang, 'categories', category.value)}>{category.value}</a></h2>
              <span class="hs-note"><span class="hs-num">{category.count}</span> {c.count}</span>
            </div>
            <ul class="hs-list">
              {posts
                .filter((post) => post.data.category === category.value)
                .map((post) => (
                  <li class="hs-list__row">
                    <time class="hs-note" datetime={post.data.publishedAt.toISOString()}>{hsDay(post.data.publishedAt)}</time>
                    <a class="hs-list__title" href={hsEntryHref(post)}>{post.data.title}</a>
                    <span class="hs-note">{post.data.tags.map((tag) => `#${tag}`).join(' ')}</span>
                  </li>
                ))}
            </ul>
          </>
        ))
      ) : (
        <p class="hs-index__summary">{ui.unavailable}</p>
      )}
    </section>
  </div>
</HanshinBase>
