---
import type { GetStaticPaths } from 'astro';
import HanshinBase from '../../../../../layouts/HanshinBase.astro';
import { SITE, UI, type Language } from '../../../../../data/site';
import { HANSHIN, hsDay, hsYear } from '../../../../../data/hanshin';
import { getListedPosts } from '../../../../../utils/content';
import { hsEntryHref } from '../../../../../utils/hanshin';

export const getStaticPaths: GetStaticPaths = () =>
  SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const c = HANSHIN[lang];
const posts = await getListedPosts(lang);
const years = [...new Set(posts.map((post) => hsYear(post.data.publishedAt)))];
---

<HanshinBase lang={lang} title={c.nav.archive} section="archive">
  <div class="hs-flow hs-plate">
    <section class="hs-opening">
      <p class="hs-note hs-note--latin hs-opening__label">Archive</p>
      <h1>{c.nav.archive}</h1>
      <p class="hs-opening__lead">{c.archiveNote}</p>
    </section>

    <hr class="hs-divider" />

    <section class="hs-section u-media" aria-label={c.nav.archive}>
      {posts.length > 0 ? (
        years.map((year) => (
          <>
            <div class="hs-year">
              <h2 class="hs-num">{year}{c.year}</h2>
              <span class="hs-note">
                <span class="hs-num">{posts.filter((post) => hsYear(post.data.publishedAt) === year).length}</span> {c.count}
              </span>
            </div>
            <ul class="hs-list">
              {posts
                .filter((post) => hsYear(post.data.publishedAt) === year)
                .map((post) => (
                  <li class="hs-list__row">
                    <time class="hs-note" datetime={post.data.publishedAt.toISOString()}>{hsDay(post.data.publishedAt)}</time>
                    <a class="hs-list__title" href={hsEntryHref(post)}>{post.data.title}</a>
                    <span class="hs-note">{post.data.category}</span>
                  </li>
                ))}
            </ul>
          </>
        ))
      ) : (
        <p class="hs-index__summary">{ui.unavailable}</p>
      )}
    </section>
  </div>
</HanshinBase>
