---
import type { GetStaticPaths } from 'astro';
import HanshinBase from '../../../../../layouts/HanshinBase.astro';
import { SITE, type Language } from '../../../../../data/site';
import { HANSHIN, hsPath } from '../../../../../data/hanshin';

export const getStaticPaths: GetStaticPaths = () =>
  SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));

const { lang } = Astro.props as { lang: Language };
const c = HANSHIN[lang];
const about = c.about;
---

<HanshinBase lang={lang} title={about.title} description={about.lead} section="about">
  <div class="hs-flow hs-plate">
    <section class="hs-opening">
      <p class="hs-note hs-note--latin hs-opening__label">About</p>
      <h1>{about.title}</h1>
      <p class="hs-opening__lead">{about.lead}</p>
    </section>

    <hr class="hs-divider" />

    <section class="hs-section" aria-label={about.title}>
      <div class="hs-prose-plain">
        {about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <dl class="hs-facts u-space-5">
        {about.facts.map(([term, value]) => (
          <div class="hs-note">
            <dt>{term}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>

      <nav class="hs-field u-space-5" aria-label={about.linksLabel}>
        <a class="hs-note" href={hsPath(lang, 'writing')}>{c.nav.writing} →</a>
        <a class="hs-note" href={`/${lang}/rss.xml`}>RSS →</a>
        <a class="hs-note" href="https://github.com/Morii9961" rel="me">GitHub →</a>
      </nav>
    </section>
  </div>
</HanshinBase>
