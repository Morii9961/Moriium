---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, UI } from '../../../data/site';
import { hsHome } from '../../../data/hanshin';
---

<BaseLayout lang="zh" title="版心设计研究" noindex>
  <header class="site-shell page-heading">
    <p class="page-heading__eyebrow">Clean-room design study</p>
    <h1>版心</h1>
    <p>围绕正文尺度、旁注层级与克制分隔线展开的三语版式研究。此处只用于比较，不会替换当前生产站点。</p>
  </header>

  <nav class="site-shell taxonomy-grid" aria-label="选择预览语言">
    {SITE.languages.map((lang) => (
      <a href={hsHome(lang)} lang={UI[lang].locale}>
        <span class="taxonomy-label">{lang.toUpperCase()}</span><br />
        <strong>{UI[lang].label}</strong><br />
        <span>{UI[lang].description}</span>
      </a>
    ))}
  </nav>
</BaseLayout>
