---
import type { GetStaticPaths } from 'astro';
import JiegeBase from '../../../../../layouts/JiegeBase.astro';
import { SITE, type Language } from '../../../../../data/site';
import { COPY, STATEMENT, jgDay, jgPath } from '../../../../../data/jiege';
import { getListedPosts, type Post, type ProtectedPost } from '../../../../../utils/content';
import { jgEntryHref } from '../../../../../utils/jiege';

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const lang of SITE.languages) {
    const posts = await getListedPosts(lang);
    for (const category of new Set(posts.map((post) => post.data.category))) {
      paths.push({
        params: { lang, category },
        props: { lang, category, posts: posts.filter((post) => post.data.category === category) },
      });
    }
  }
  return paths;
};

const { lang, category, posts } = Astro.props as {
  lang: Language;
  category: string;
  posts: Array<Post | ProtectedPost>;
};
const c = COPY[lang];
const s = STATEMENT[lang];
---

<JiegeBase lang={lang} title={`${category} · ${c.nav.categories}`} section="categories">
  <div class="jg-field">
    <div class="jg-row jg-row--lead">
      <div class="jg-cell jg-head">
        <p class="jg-note"><a href={jgPath(lang, 'categories')}>{c.nav.categories}</a></p>
        <h1>{category}</h1>
      </div>
      <dl class="jg-cell jg-ledger jg-note">
        <div>
          <dt>{s.n.posts}</dt>
          <dd class="jg-num">{posts.length}</dd>
        </div>
      </dl>
    </div>

    <div class="jg-row">
      <section class="jg-cell" aria-label={category}>
        <ol class="jg-stack jg-stack--roomy">
          {posts.map((post) => (
            <li>
              <p class="jg-note jg-entry__meta">
                <time datetime={post.data.publishedAt.toISOString()}>{jgDay(post.data.publishedAt)}</time>
                {post.data.tags.map((tag) => <a href={jgPath(lang, 'tags', tag)}>#{tag}</a>)}
              </p>
              <h2 class="jg-entry__title"><a href={jgEntryHref(post)}>{post.data.title}</a></h2>
              <p class="jg-entry__summary">{post.data.summary}</p>
            </li>
          ))}
        </ol>
        <p class="jg-note jg-cell__note"><a href={jgPath(lang, 'writing')}>{c.backToWriting}</a></p>
      </section>
    </div>
  </div>
</JiegeBase>
