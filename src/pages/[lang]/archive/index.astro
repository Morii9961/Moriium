---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { getListedPosts, postPath } from '../../../utils/content';

export function getStaticPaths() {
  return SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const posts = await getListedPosts(lang);

// The archive reads as one chronological axis, so the data is grouped the way
// the axis is read: year, then month, then the individual days. `getListedPosts`
// already returns newest first, so each group keeps that order.
const years = Map.groupBy(posts, (post) => post.data.publishedAt.getFullYear());
const yearGroups = [...years.entries()]
  .sort(([a], [b]) => b - a)
  .map(([year, entries]) => {
    const months = Map.groupBy(entries, (post) => post.data.publishedAt.getMonth());
    return {
      year,
      entries,
      months: [...months.entries()]
        .sort(([a], [b]) => b - a)
        .map(([month, monthEntries]) => ({ month, entries: monthEntries })),
    };
  });

const copy = {
  zh: {
    title: '归档', intro: '所有文章按年份排列，新写的在前面。', years: '年份', posts: '文章', monthUnit: '月',
    entries: (count: number) => `${String(count).padStart(2, '0')} 篇`,
    emptyTitle: '还没有文章', emptyCount: '00 篇', empty: '这个语言版本暂时没有可以公开列出的文章。',
  },
  ja: {
    title: 'アーカイブ', intro: '公開中の記事を年ごとに、新しい順で並べています。', years: '年数', posts: '記事', monthUnit: '月',
    entries: (count: number) => `${String(count).padStart(2, '0')} 件`,
    emptyTitle: '記事はまだありません', emptyCount: '00 件', empty: 'この言語で公開中の記事はまだありません。',
  },
  en: {
    title: 'Archive', intro: 'Every public post, grouped by year and ordered newest first.', years: 'Years', posts: 'Posts', monthUnit: '',
    entries: (count: number) => `${String(count).padStart(2, '0')} ${count === 1 ? 'entry' : 'entries'}`,
    emptyTitle: 'No posts yet', emptyCount: '00 entries', empty: 'There are no listed posts in this language yet.',
  },
} as const;
const c = copy[lang];
const pad = (value: number) => String(value).padStart(2, '0');
// Chinese and Japanese read a padded figure followed by 月, so the axis keeps a
// single numeric shape. English has no such unit word and takes a short name.
// Mid-month noon UTC keeps the formatted name inside the intended month in
// every time zone.
const monthFigure = (year: number, month: number) =>
  c.monthUnit
    ? pad(month + 1)
    : new Intl.DateTimeFormat(ui.locale, { month: 'short' }).format(new Date(Date.UTC(year, month, 15, 12))).toUpperCase();
---

<BaseLayout lang={lang} title={c.title}>
  <div class="a-directory">
    <header class="a-directory__hero">
      <p class="prototype-kicker">Archive / Years</p>
      <div class="a-directory__title"><h1>{c.title}</h1><p>{c.intro}</p></div>
      <dl class="a-directory__stats">
        <div><dt>{c.years}</dt><dd>{pad(years.size)}</dd></div>
        <div><dt>{c.posts}</dt><dd>{pad(posts.length)}</dd></div>
      </dl>
    </header>

    {yearGroups.length > 0 ? yearGroups.map(({ year, entries, months }) => (
      <section class="a-archive" aria-labelledby={`archive-${year}`}>
        <header class="a-archive__year"><h2 id={`archive-${year}`}>{year}</h2><p>{c.entries(entries.length)}</p></header>
        <ol class="a-archive__months">
          {months.map(({ month, entries: monthEntries }) => (
            <li class="a-archive__month">
              <h3 class="a-archive__month-mark">
                <time datetime={`${year}-${pad(month + 1)}`}>{monthFigure(year, month)}</time>
                {c.monthUnit && <small>{c.monthUnit}</small>}
              </h3>
              <ol class="a-archive__days">
                {monthEntries.map((post) => (
                  <li>
                    <time datetime={post.data.publishedAt.toISOString()}>{pad(post.data.publishedAt.getDate())}</time>
                    <a href={postPath(post)}>{post.data.title}</a>
                    <span>{post.data.category}</span>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </section>
    )) : (
      <section class="a-archive a-archive--quiet" aria-labelledby="archive-empty-title">
        <header class="a-archive__year"><h2 id="archive-empty-title">{c.emptyTitle}</h2><p>{c.emptyCount}</p></header>
        <p class="a-archive__empty">{c.empty}</p>
      </section>
    )}
  </div>
</BaseLayout>
