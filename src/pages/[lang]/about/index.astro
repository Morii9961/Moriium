---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutActivity from '../../../components/AboutActivity.astro';
import { SITE, type Language } from '../../../data/site';

export const getStaticPaths: GetStaticPaths = () =>
  SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));

const { lang } = Astro.props as { lang: Language };

const CHANNELS = [
  { name: 'GitHub', handle: 'github.com/Morii9961', href: 'https://github.com/Morii9961' },
  { name: 'X', handle: 'x.com/morii9961', href: 'https://x.com/morii9961' },
  { name: 'Bilibili', handle: 'space.bilibili.com/670549003', href: 'https://space.bilibili.com/670549003' },
] as const;

const copy = {
  zh: {
    title: '这个地方',
    intro: 'Moriium 是 Morii 的私人数字档案。文章、照片、旅行记录与技术笔记，陆续归在这里。',
    place: 'This place',
    statement: '写下的、拍下的，慢慢留下。',
    body: [
      '没有固定主题，也没有更新计划。内容按时间、分类与标签保存。',
      '公开页面预先生成；受保护文章在本地加密。阅读不需要账户，也不记录访问行为。',
    ],
    kinds: '收存内容', kindsNote: 'Four kinds',
    kindList: [
      ['文章', '主题与长度不固定。'],
      ['摄影笔记', '照片为主，文字只补充必要背景。'],
      ['旅行记录', '按地点与行程整理。'],
      ['技术随笔', '记录做过的事，也保留当时的判断。'],
    ],
    colophon: '站点说明', colophonNote: 'Colophon',
    facts: [
      ['字体', '公开页面使用 Noto Serif SC/JP；首页题字使用 Shippori Mincho；日期与数据使用 IBM Plex Mono。'],
      ['构建', '公开页面预先生成，搜索索引只在打开搜索时载入。'],
      ['访问', '不使用分析脚本、访问计数或读者账户。'],
      ['许可', '代码采用 MIT 许可；文章、照片与其他内容保留所有权利。'],
    ],
    reach: '订阅与其他地址', reachNote: 'Feeds and elsewhere',
    feedBody: '三种语言各有一份 RSS，收录对应语言的公开文章。',
    feedLabel: { zh: '中文 RSS', ja: '日本語 RSS', en: 'English RSS' },
    channelNotes: {
      GitHub: '源码与公开问题记录。',
      X: '偶尔更新近况。',
      Bilibili: '视频存放处。',
    },
    linksLabel: '继续浏览', read: '文章索引',
  },
  ja: {
    title: 'この場所',
    intro: 'Moriium は Morii の個人アーカイブです。文章、写真、旅の記録、技術ノートを少しずつ収めています。',
    place: 'This place',
    statement: '書いたもの、撮ったものを、少しずつ残す。',
    body: [
      'テーマも更新予定も決めていません。内容は日付、カテゴリー、タグで整理しています。',
      '公開ページは事前に生成し、保護記事はローカルで暗号化します。閲覧にアカウントは不要で、アクセスも計測しません。',
    ],
    kinds: '収めるもの', kindsNote: 'Four kinds',
    kindList: [
      ['文章', '主題も長さも固定しません。'],
      ['写真の記録', '写真を主に、文章は必要な背景だけを補います。'],
      ['旅の記録', '場所と行程ごとに整理します。'],
      ['技術ノート', '実際に行ったことと、その時点の判断を残します。'],
    ],
    colophon: 'サイト情報', colophonNote: 'Colophon',
    facts: [
      ['書体', '公開ページは Noto Serif SC/JP、ホームの題字は Shippori Mincho、日付とデータは IBM Plex Mono を使用します。'],
      ['ビルド', '公開ページは事前に生成し、検索索引は検索を開いたときだけ読み込みます。'],
      ['アクセス', '解析スクリプト、アクセスカウンター、読者アカウントは使用しません。'],
      ['ライセンス', 'コードは MIT ライセンス。文章、写真、その他のコンテンツの権利は作者に帰属します。'],
    ],
    reach: '購読とほかの場所', reachNote: 'Feeds and elsewhere',
    feedBody: '三つの言語にそれぞれ RSS があり、対応する言語の公開記事を収めています。',
    feedLabel: { zh: '中文 RSS', ja: '日本語 RSS', en: 'English RSS' },
    channelNotes: {
      GitHub: 'ソースコードと公開の課題記録。',
      X: '近況をときどき更新します。',
      Bilibili: '動画の保管場所。',
    },
    linksLabel: '次に読む', read: '記事索引',
  },
  en: {
    title: 'This place',
    intro: 'Moriium is Morii’s private archive of writing, photographs, travel records, and technical notes.',
    place: 'This place',
    statement: 'What is written and photographed is kept here over time.',
    body: [
      'There is no fixed subject or publishing schedule. Entries are filed by date, category, and tag.',
      'Public pages are built in advance; protected posts are encrypted locally. Reading requires no account and is not tracked.',
    ],
    kinds: 'Contents', kindsNote: 'Four kinds',
    kindList: [
      ['Writing', 'No fixed subject or length.'],
      ['Photography notes', 'The photograph comes first; text adds only necessary context.'],
      ['Travel records', 'Filed by place and journey.'],
      ['Technical notes', 'What was built, together with the judgement made at the time.'],
    ],
    colophon: 'Colophon', colophonNote: 'Site facts',
    facts: [
      ['Type', 'Public pages use Noto Serif SC/JP; the home title uses Shippori Mincho; dates and data use IBM Plex Mono.'],
      ['Build', 'Public pages are built in advance. The search index loads only when search is opened.'],
      ['Access', 'No analytics, view counters, or reader accounts.'],
      ['Rights', 'Code is MIT licensed. Writing, photographs, and other content are all rights reserved.'],
    ],
    reach: 'Feeds and elsewhere', reachNote: 'Feeds and elsewhere',
    feedBody: 'Each language has its own feed containing its public posts.',
    feedLabel: { zh: '中文 RSS', ja: '日本語 RSS', en: 'English RSS' },
    channelNotes: {
      GitHub: 'Source code and public issue records.',
      X: 'Occasional updates.',
      Bilibili: 'Video archive.',
    },
    linksLabel: 'Keep exploring', read: 'Writing index',
  },
} as const;
const c = copy[lang];
const pad = (value: number) => String(value + 1).padStart(2, '0');
---

<BaseLayout lang={lang} title={c.title}>
  <div class="a-directory a-about-page">
    <header class="a-directory__hero">
      <p class="prototype-kicker">Moriium / About</p>
      <div class="a-directory__title"><h1>{c.title}</h1><p>{c.intro}</p></div>
    </header>

    <section class="a-about-page__statement" aria-labelledby="about-statement">
      <p class="prototype-kicker">{c.place}</p>
      <h2 id="about-statement">{c.statement}</h2>
      <div>{c.body.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>

    <section class="a-about-page__band" aria-labelledby="about-kinds">
      <header class="a-about-page__head"><h2 id="about-kinds">{c.kinds}</h2><p>{c.kindsNote}</p></header>
      <ol class="a-about-page__rows">
        {c.kindList.map(([term, gloss], index) => (
          <li><span>{pad(index)}</span><div><h3>{term}</h3><p>{gloss}</p></div></li>
        ))}
      </ol>
    </section>

    <section class="a-about-page__band a-about-page__colophon" aria-labelledby="about-colophon">
      <header class="a-about-page__head"><h2 id="about-colophon">{c.colophon}</h2><p>{c.colophonNote}</p></header>
      <dl class="a-about-page__inset">
        {c.facts.map(([term, description]) => (
          <div><dt>{term}</dt><dd>{description}</dd></div>
        ))}
      </dl>
    </section>

    <AboutActivity lang={lang} />

    <section class="a-about-page__band" aria-labelledby="about-reach">
      <header class="a-about-page__head"><h2 id="about-reach">{c.reach}</h2><p>{c.reachNote}</p></header>
      <p>{c.feedBody}</p>
      <p class="a-about-page__feeds">
        {SITE.languages.map((code) => (
          <a class="aperture-action" href={`/${code}/rss.xml`}><span>{c.feedLabel[code]}</span><i>↗</i></a>
        ))}
      </p>
      <dl class="a-about-page__inset a-about-page__channels">
        {CHANNELS.map((channel) => (
          <div>
            <dt>{channel.name}</dt>
            <dd><a href={channel.href} rel="me">{channel.handle}</a>{c.channelNotes[channel.name]}</dd>
          </div>
        ))}
      </dl>
    </section>

    <nav class="a-about-page__end" aria-label={c.linksLabel}>
      <a class="aperture-action" href={`/${lang}/writing/`}><span>{c.read}</span><i>→</i></a>
    </nav>
  </div>
</BaseLayout>
