---
/*
 * About. The one page on the site that is mostly prose, so it is set on the
 * reading measure and uses the article's own typography rather than a separate
 * marketing layout. The three principles are a numbered list because they
 * genuinely are an ordered statement of priority, not decoration.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionMark from '../../../components/SectionMark.astro';
import { SITE, type Language } from '../../../data/site';

export const getStaticPaths: GetStaticPaths = () =>
  SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));

const { lang } = Astro.props as { lang: Language };
const copy = {
  zh: {
    title: '关于 Moriium', intro: 'Moriium 是 Morii 的个人博客。这里放文章、摄影笔记、旅行记录和技术随笔。',
    author: '作者', languages: '语言', languageValue: '中 · 日 · EN',
    statementMark: '这个地方',
    statement: '把值得保留的东西，放在一个可以慢慢阅读的地方。',
    body: [
      '这里不追赶即时动态，也不要求所有内容长成同一种样子。照片可以展开，代码需要清楚；其他时候，页面只安静地承载文字。',
      '网站以静态方式生成。公开文章可以持续整理，受保护内容先在本地加密；阅读不需要账户、数据库或常驻服务。',
    ],
    principlesMark: '站点原则',
    principles: '三条安静的规则',
    rules: [
      ['内容先于装饰', '设计为阅读建立节奏，不抢走文章本身的注意力。'],
      ['功能按需出现', '灯箱、图表、音乐与解密模块只在对应文章需要时加载。'],
      ['长期重于即时', '链接、归档、翻译状态与订阅入口保持清楚、稳定、可回访。'],
    ],
    linksMark: '继续浏览', linksLabel: '继续浏览',
    read: '继续阅读', writing: '全部文章 ↗',
    update: '保持更新', rss: 'RSS 订阅 ↗',
    elsewhere: '其他地方', github: 'GitHub ↗',
  },
  ja: {
    title: 'Moriium について', intro: 'Moriium は Morii の個人ブログです。文章、写真のメモ、旅の記録、技術ノートを置いています。',
    author: '作者', languages: '言語', languageValue: '中 · 日 · EN',
    statementMark: 'この場所',
    statement: '残しておきたいものを、ゆっくり読める場所へ。',
    body: [
      'ここは短い近況を追いかける場所ではなく、すべてを同じ形にも揃えません。写真は大きく開き、コードは読みやすくする。それ以外のときは、文章を静かに載せます。',
      'サイトは静的に生成します。公開記事は継続して整え、保護記事はローカルで暗号化してから公開します。閲覧にアカウント、データベース、常駐サービスは不要です。',
    ],
    principlesMark: 'サイトの方針',
    principles: '三つの静かな規則',
    rules: [
      ['内容を先に置く', 'デザインは読むためのリズムをつくり、記事から注意を奪いません。'],
      ['機能は必要なときだけ', '写真、図表、音楽、復号の機能は、必要な記事でだけ読み込みます。'],
      ['速さより長く残ること', 'リンク、アーカイブ、翻訳状況、購読入口を明確で安定した状態に保ちます。'],
    ],
    linksMark: '次に読む', linksLabel: '次に読む',
    read: '記事を読む', writing: 'すべての記事 ↗',
    update: '更新を受け取る', rss: 'RSS を購読 ↗',
    elsewhere: 'ほかの場所', github: 'GitHub ↗',
  },
  en: {
    title: 'About Moriium', intro: "Moriium is Morii's personal blog for essays, photography notes, travel records, and technical writing.",
    author: 'Author', languages: 'Languages', languageValue: 'ZH · JA · EN',
    statementMark: 'This place',
    statement: 'A place to keep what matters and read it slowly.',
    body: [
      'This is not a feed of passing updates, and every piece need not take the same shape. Photographs can open wide, code stays legible, and plain pages carry the rest.',
      'The site builds to static files. Public posts remain editable; protected posts are encrypted locally before publication. Reading requires no account, database, or always-on application service.',
    ],
    principlesMark: 'Site principles',
    principles: 'Three quiet rules',
    rules: [
      ['Content before decoration', 'Design gives reading a rhythm without competing with the work.'],
      ['Features appear when needed', 'Lightboxes, diagrams, music, and decryption load only for posts that use them.'],
      ['Longevity over immediacy', 'Links, archives, translation status, and feeds stay clear, stable, and easy to revisit.'],
    ],
    linksMark: 'Keep exploring', linksLabel: 'Keep exploring',
    read: 'Keep reading', writing: 'All writing ↗',
    update: 'Stay updated', rss: 'RSS feed ↗',
    elsewhere: 'Elsewhere', github: 'GitHub ↗',
  },
} as const;
const c = copy[lang];
---

<BaseLayout lang={lang} title={c.title}>
  <section class="measure measure--prose page-head">
    <h1>{c.title}</h1>
    <p class="page-head__lede">{c.intro}</p>
    <dl class="page-head__facts">
      <div><dt>{c.author}</dt><dd>{SITE.author}</dd></div>
      <div><dt>{c.languages}</dt><dd>{c.languageValue}</dd></div>
    </dl>
  </section>

  <section class="measure measure--prose band" aria-labelledby="about-statement">
    <SectionMark label={c.statementMark} lead />
    <h2 class="band__heading" id="about-statement">{c.statement}</h2>
    <div class="article-body band__body">
      {c.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="measure measure--prose band" aria-labelledby="about-principles">
    <SectionMark label={c.principlesMark} aside="01 — 03" />
    <h2 class="band__heading" id="about-principles">{c.principles}</h2>
    <ol class="principles">
      {c.rules.map(([title, description]) => (
        <li>
          <div>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="measure measure--media band" aria-labelledby="about-links">
    <SectionMark label={c.linksMark} />
    <h2 class="visually-hidden" id="about-links">{c.linksLabel}</h2>
    <nav class="entries" aria-label={c.linksLabel}>
      <a href={`/${lang}/writing/`}><strong>{c.read}</strong><span>{c.writing}</span></a>
      <a href={`/${lang}/rss.xml`}><strong>{c.update}</strong><span>{c.rss}</span></a>
      <a href="https://github.com/Morii9961" rel="me"><strong>{c.elsewhere}</strong><span>{c.github}</span></a>
    </nav>
  </section>
</BaseLayout>
