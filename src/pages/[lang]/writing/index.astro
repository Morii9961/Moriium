---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { formatDate, getListedPosts, postPath, uniqueTaxonomy } from '../../../utils/content';

export function getStaticPaths() {
  return SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const posts = await getListedPosts(lang);
const latest = posts[0]?.data.publishedAt;
const copy = {
  zh: {
    title: '文章', intro: '公开留下的文章，新写的在前。', count: '文章', updated: '最近更新', list: '全部文章',
    unitOne: ' 篇', unitMany: ' 篇', filter: '筛选', all: '全部', categories: '分类', tags: '标签',
    filterHint: '按分类或标签筛选', search: '搜索',
    searchHint: '搜索当前列表', searchLabel: '标题、摘要、分类或标签', searchPlaceholder: '标题、分类或标签',
    empty: '没有相符的文章。',
  },
  ja: {
    title: '記事', intro: '公開中の記事を、新しいものから。', count: '記事', updated: '最近の更新', list: 'すべての記事',
    unitOne: ' 件', unitMany: ' 件', filter: '絞り込み', all: 'すべて', categories: 'カテゴリー', tags: 'タグ',
    filterHint: 'カテゴリーまたはタグで絞り込む', search: '検索',
    searchHint: '現在の一覧を検索', searchLabel: 'タイトル・概要・カテゴリー・タグ', searchPlaceholder: 'タイトル、カテゴリー、タグ',
    empty: '該当する記事はありません。',
  },
  en: {
    title: 'Writing', intro: 'Public writing, newest first.', count: 'Posts', updated: 'Latest update', list: 'All posts',
    unitOne: ' post', unitMany: ' posts', filter: 'Filter', all: 'All', categories: 'Categories', tags: 'Tags',
    filterHint: 'Filter by category or tag', search: 'Search',
    searchHint: 'Search this list', searchLabel: 'Title, summary, category, or tag', searchPlaceholder: 'Title, category, or tag',
    empty: 'No matching posts.',
  },
} as const;
const c = copy[lang];
const number = (value: number) => String(value).padStart(2, '0');
const categories = uniqueTaxonomy(posts, 'category').map((name) => ({
  name,
  count: posts.filter((post) => post.data.category === name).length,
}));
const tags = uniqueTaxonomy(posts, 'tags')
  .map((name) => ({ name, count: posts.filter((post) => post.data.tags.includes(name)).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, ui.locale));
---

<BaseLayout lang={lang} title={c.title}>
  <div class="a-directory">
    <header class="a-directory__hero">
      <p class="prototype-kicker">Writing / Index</p>
      <div class="a-directory__title"><h1>{c.title}</h1><p>{c.intro}</p></div>
      <dl class="a-directory__stats">
        <div><dt>{c.count}</dt><dd>{number(posts.length)}</dd></div>
        <div><dt>{c.updated}</dt><dd>{latest ? new Intl.DateTimeFormat(ui.locale, { year: 'numeric', month: '2-digit' }).format(latest) : '—'}</dd></div>
      </dl>
    </header>
    <section class="a-directory__section" aria-labelledby="writing-list-title" data-writing-index>
      <header class="a-directory__section-head a-directory__section-head--controls">
        <h2 id="writing-list-title">{c.list}</h2>
        <div
          class="a-writing-controls"
          data-writing-controls
          data-searching="false"
          data-unit-one={c.unitOne}
          data-unit-many={c.unitMany}
          data-label-categories={c.categories}
          data-label-tags={c.tags}
        >
          <details class="a-writing-filter" data-writing-filter data-active="false">
            <summary title={c.filterHint}>
              <span class="a-writing-filter__label">{c.filter}</span>
              <span class="a-writing-filter__value" data-writing-value>{c.all}</span>
              <svg class="a-writing-filter__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m5.5 9 6.5 6.5L18.5 9"></path></svg>
            </summary>
            <div class="a-writing-filter__menu" data-writing-menu>
              <a
                class="a-writing-filter__option a-writing-filter__option--all"
                href={`/${lang}/writing/`}
                data-filter-kind="all"
                data-filter-value=""
                data-filter-name={c.all}
              ><span>{c.all}</span><small>{number(posts.length)}</small></a>
              {categories.length > 0 && (
                <div class="a-writing-filter__column">
                  <span class="a-writing-filter__group" id="writing-filter-categories">{c.categories}</span>
                  <div class="a-writing-filter__options" role="group" aria-labelledby="writing-filter-categories">
                    {categories.map(({ name, count }) => (
                      <a
                        class="a-writing-filter__option"
                        href={`/${lang}/categories/${encodeURIComponent(name)}/`}
                        data-filter-kind="category"
                        data-filter-value={name}
                        data-filter-name={name}
                      ><span>{name}</span><small>{number(count)}</small></a>
                    ))}
                  </div>
                </div>
              )}
              {tags.length > 0 && (
                <div class="a-writing-filter__column">
                  <span class="a-writing-filter__group" id="writing-filter-tags">{c.tags}</span>
                  <div class="a-writing-filter__options" role="group" aria-labelledby="writing-filter-tags">
                    {tags.map(({ name, count }) => (
                      <a
                        class="a-writing-filter__option"
                        href={`/${lang}/tags/${encodeURIComponent(name)}/`}
                        data-filter-kind="tag"
                        data-filter-value={name}
                        data-filter-name={`# ${name}`}
                      ><span># {name}</span><small>{number(count)}</small></a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </details>
          <div class="a-writing-search">
            <button
              class="a-writing-search__toggle"
              type="button"
              aria-expanded="false"
              aria-controls="writing-search"
              aria-label={c.searchHint}
              title={c.searchHint}
              data-writing-search-toggle
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"></circle><path d="m16 16 4.2 4.2"></path></svg>
              <span class="a-writing-search__label">{c.search}</span>
            </button>
            <label class="visually-hidden" for="writing-search">{c.searchLabel}</label>
            <input
              id="writing-search"
              class="a-writing-search__input"
              type="search"
              inputmode="search"
              autocomplete="off"
              placeholder={c.searchPlaceholder}
              data-writing-search-input
            />
          </div>
          <p class="visually-hidden" aria-live="polite" data-writing-live></p>
        </div>
      </header>
      <ol class="prototype-posts a-post-index" data-writing-list>
        {posts.map((post, index) => (
          <li class="prototype-post" data-category={post.data.category} data-tags={JSON.stringify(post.data.tags)}><a href={postPath(post)}>
            <span data-writing-number>{number(index + 1)}</span>
            <div><h3>{post.data.title}</h3><p>{post.data.summary}</p></div>
            <span>{post.data.category}</span>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, ui.locale)}</time>
            <span class="a-post-index__arrow" aria-hidden="true">↗</span>
          </a></li>
        ))}
      </ol>
      <p class="a-writing-empty" data-writing-empty hidden>{c.empty}</p>
    </section>
  </div>

  <script>
    // Progressive enhancement only. Without this module the filter is still a
    // disclosure holding real category and tag links, so it degrades into
    // navigation rather than into nothing, and the list stays whole.
    const index = document.querySelector<HTMLElement>('[data-writing-index]');
    const controls = index?.querySelector<HTMLElement>('[data-writing-controls]');
    const filter = index?.querySelector<HTMLDetailsElement>('[data-writing-filter]');
    const summary = filter?.querySelector('summary');
    const menu = filter?.querySelector<HTMLElement>('[data-writing-menu]');
    const label = filter?.querySelector<HTMLElement>('[data-writing-value]');
    const toggle = index?.querySelector<HTMLButtonElement>('[data-writing-search-toggle]');
    const field = index?.querySelector<HTMLInputElement>('[data-writing-search-input]');
    const live = index?.querySelector<HTMLElement>('[data-writing-live]');
    const empty = index?.querySelector<HTMLElement>('[data-writing-empty]');
    const list = index?.querySelector<HTMLElement>('[data-writing-list]');

    if (index && controls && filter && summary && menu && label && toggle && field && live && empty && list) {
      const locale = document.documentElement.lang || 'en';
      const unitOne = controls.dataset.unitOne ?? '';
      const unitMany = controls.dataset.unitMany ?? '';
      const options = Array.from(menu.querySelectorAll<HTMLAnchorElement>('[data-filter-kind]'));
      const fold = (value: string) => value.normalize('NFKC').toLocaleLowerCase(locale);
      const entries = Array.from(list.querySelectorAll<HTMLLIElement>('li')).map((item) => {
        const tags = JSON.parse(item.dataset.tags ?? '[]') as string[];
        return {
          item,
          number: item.querySelector<HTMLElement>('[data-writing-number]'),
          category: item.dataset.category ?? '',
          tags,
          // Title, summary, category and date already print inside the row. The
          // tags are the only thing a reader can act on but not read off it, so
          // they are appended rather than looked up again on every keystroke.
          haystack: fold(`${item.textContent ?? ''} ${tags.join(' ')}`),
        };
      });

      type Axis = 'category' | 'tag';

      // Two axes, each multi-select. Within an axis the choices are
      // alternatives -- two categories mean either of them -- and across axes
      // they narrow each other, so a category and a tag mean both. "All" is the
      // reset rather than a third kind of choice.
      const selected: Record<Axis, Set<string>> = { category: new Set(), tag: new Set() };
      const axisLabels: Record<Axis, string> = {
        category: controls.dataset.labelCategories ?? '',
        tag: controls.dataset.labelTags ?? '',
      };
      const allOption = options.find((option) => option.dataset.filterKind === 'all');
      const axisOf = (option: HTMLAnchorElement): Axis | null => {
        const kind = option.dataset.filterKind;
        return kind === 'category' || kind === 'tag' ? kind : null;
      };
      const chosenCount = () => selected.category.size + selected.tag.size;
      let query = '';

      // The summary is one line. A single choice prints itself; more print how
      // many of each, because three names do not fit on that line and a
      // truncated name says less than a number does.
      const describe = () => {
        if (chosenCount() === 0) return allOption?.dataset.filterName ?? '';
        if (chosenCount() === 1) {
          const only = options.find((option) => {
            const axis = axisOf(option);
            return axis !== null && selected[axis].has(option.dataset.filterValue ?? '');
          });
          return only?.dataset.filterName ?? '';
        }
        const parts: string[] = [];
        for (const axis of ['category', 'tag'] as const) {
          if (selected[axis].size > 0) {
            parts.push(`${axisLabels[axis]} ${String(selected[axis].size).padStart(2, '0')}`);
          }
        }
        return parts.join(' · ');
      };

      // One pass for both narrowings: the panel decides which rows belong, the
      // field decides which of those still match, and the ledger renumbers so a
      // narrowed list still reads 01, 02, 03.
      const render = (remember: boolean) => {
        const needle = fold(query.trim());
        let shown = 0;

        for (const entry of entries) {
          const inFilter =
            (selected.category.size === 0 || selected.category.has(entry.category)) &&
            (selected.tag.size === 0 || entry.tags.some((tag) => selected.tag.has(tag)));
          const matches = inFilter && (!needle || entry.haystack.includes(needle));
          entry.item.hidden = !matches;
          if (!matches) continue;
          shown += 1;
          if (entry.number) entry.number.textContent = String(shown).padStart(2, '0');
        }

        empty.hidden = shown > 0;
        // The count the head used to print is gone, so the result stays
        // announced even though nothing draws it any more.
        live.textContent = `${String(shown).padStart(2, '0')}${shown === 1 ? unitOne : unitMany}`;
        label.textContent = describe();
        filter.dataset.active = String(chosenCount() > 0);

        for (const option of options) {
          const axis = axisOf(option);
          const pressed = axis === null
            ? chosenCount() === 0
            : selected[axis].has(option.dataset.filterValue ?? '');
          option.setAttribute('aria-pressed', String(pressed));
        }

        if (!remember) return;
        const url = new URL(window.location.href);
        url.searchParams.delete('category');
        url.searchParams.delete('tag');
        url.searchParams.delete('q');
        for (const axis of ['category', 'tag'] as const) {
          if (selected[axis].size > 0) url.searchParams.set(axis, [...selected[axis]].join(','));
        }
        if (query.trim()) url.searchParams.set('q', query.trim());
        history.replaceState(null, '', url);
      };

      const clear = () => {
        selected.category.clear();
        selected.tag.clear();
      };

      const toggleOption = (option: HTMLAnchorElement, remember: boolean) => {
        const axis = axisOf(option);
        if (axis === null) {
          clear();
        } else {
          const value = option.dataset.filterValue ?? '';
          const set = selected[axis];
          if (set.has(value)) set.delete(value);
          else set.add(value);
        }
        render(remember);
      };

      // Enhanced, each option is a toggle rather than a link to one page, and it
      // has to say so: a reader on a screen reader is told "pressed" instead of
      // being told this leads somewhere. The href stays, so a modified click
      // still opens the real category or tag page.
      for (const option of options) {
        option.setAttribute('role', 'button');
      }

      const close = (restore: boolean) => {
        if (!filter.open) return;
        filter.open = false;
        if (restore) summary.focus();
      };

      // Search opens in place rather than over the page. The filter folds away
      // with it and its constraint goes too: a narrowing the reader can no
      // longer see is one they cannot undo.
      const setSearch = (open: boolean, moveFocus = true) => {
        controls.dataset.searching = String(open);
        toggle.setAttribute('aria-expanded', String(open));
        if (open) {
          close(false);
          if (chosenCount() > 0) {
            clear();
            render(true);
          }
          field.focus();
          return;
        }
        field.value = '';
        query = '';
        render(true);
        if (moveFocus) toggle.focus();
      };

      toggle.addEventListener('click', () => setSearch(controls.dataset.searching !== 'true'));

      field.addEventListener('input', () => {
        query = field.value;
        render(true);
      });

      field.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setSearch(false);
      });

      // An empty field left behind puts the filter back rather than sitting open
      // with the dropdown hidden. A blur towards the toggle is left alone,
      // because the click that follows it closes the field itself.
      field.addEventListener('blur', (event) => {
        if (field.value || event.relatedTarget === toggle) return;
        setSearch(false, false);
      });

      // The panel stays open on a choice, because choosing more than one is the
      // point of it; Escape, the summary, or a click outside closes it.
      menu.addEventListener('click', (event) => {
        // A modified click still belongs to the browser: it opens the real
        // category or tag page instead of filtering in place.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const option = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-filter-kind]');
        if (!option) return;
        event.preventDefault();
        toggleOption(option, true);
      });

      // role="button" promises the space bar, which an anchor does not give.
      menu.addEventListener('keydown', (event) => {
        if (event.key !== ' ' && event.key !== 'Spacebar') return;
        const option = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-filter-kind]');
        if (!option) return;
        event.preventDefault();
        toggleOption(option, true);
      });

      filter.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          close(true);
          return;
        }
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        filter.open = true;
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const current = options.indexOf(document.activeElement as HTMLAnchorElement);
        const next = current < 0 ? (step > 0 ? 0 : options.length - 1) : (current + step + options.length) % options.length;
        options[next]?.focus();
      });

      document.addEventListener('click', (event) => {
        if (filter.contains(event.target as Node)) return;
        close(false);
      });

      // A shared link carries whichever narrowing produced it, and a narrowing
      // can now be several choices at once. Values that no longer exist are
      // dropped rather than filtering the list away to nothing.
      const params = new URLSearchParams(window.location.search);
      for (const axis of ['category', 'tag'] as const) {
        const raw = params.get(axis);
        if (!raw) continue;
        for (const value of raw.split(',')) {
          const known = options.some(
            (option) => axisOf(option) === axis && option.dataset.filterValue === value,
          );
          if (known) selected[axis].add(value);
        }
      }
      const restoredQuery = params.get('q') ?? '';
      if (restoredQuery) {
        field.value = restoredQuery;
        query = restoredQuery;
        controls.dataset.searching = 'true';
        toggle.setAttribute('aria-expanded', 'true');
      }
      render(false);
    }
  </script>
</BaseLayout>
