---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getListedPosts, getPublishedPosts, getTranslations, postPath, routeSlug } from '../../../utils/content';
import { detectReaderFeatures } from '../../../utils/features';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: routeSlug(post) },
    props: { post },
  }));
};

const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const { Content, headings } = await render(post);
const translations = await getTranslations(post.data.translationKey);
const features = detectReaderFeatures(post.body ?? '', post.data.copyProtection);
const listedPosts = await getListedPosts(post.data.lang);
const listedIndex = listedPosts.findIndex((entry) => postPath(entry) === postPath(post));
const previous = listedIndex >= 0 ? listedPosts[listedIndex + 1] : undefined;
const next = listedIndex > 0 ? listedPosts[listedIndex - 1] : undefined;
const listedCategories = new Set(listedPosts.map((entry) => entry.data.category));
const listedTags = new Set(listedPosts.flatMap((entry) => entry.data.tags));
const adjacentProps = { ...(previous ? { previous } : {}), ...(next ? { next } : {}) };
---

<ArticleLayout
  post={post}
  translations={translations}
  features={features}
  headings={headings}
  linkCategory={listedCategories.has(post.data.category)}
  linkedTags={post.data.tags.filter((tag) => listedTags.has(tag))}
  {...adjacentProps}
>
  <Content />
</ArticleLayout>
