---
/*
 * The tag field. Size carries frequency, which is information a reader can use,
 * and the chip shape is the one place DESIGN.md 7.3 reserves a pill for. The
 * scale is bounded so the rarest tag is still comfortably readable and the most
 * used one never turns into a headline.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { getListedPosts, uniqueTaxonomy } from '../../../utils/content';

export function getStaticPaths() {
  return SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const posts = await getListedPosts(lang);
const tagEntries = uniqueTaxonomy(posts, 'tags')
  .map((name) => ({ name, count: posts.filter((post) => post.data.tags.includes(name)).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, ui.locale));
const busiest = tagEntries[0]?.count ?? 1;

// 0.9375rem to 1.25rem, so frequency is visible without the field turning into
// a word cloud. A single-post tag stays above the site's smallest reading size.
const tagSize = (count: number) => `${(0.9375 + 0.3125 * ((count - 1) / Math.max(1, busiest - 1))).toFixed(4)}rem`;

const copy = {
  zh: {
    title: '标签', intro: '一些会在不同主题之间反复出现的词。按使用次数排列，也保留文章之间更细的联系。',
    tags: '标签数', posts: '篇数',
    emptyTitle: '还没有标签', empty: '这个语言版本暂时没有可以公开列出的标签。',
    crosslink: '想从更稳定的主题进入？', categories: '转到分类 →',
    label: (name: string, count: number) => `${name}，${count} 篇文章`,
  },
  ja: {
    title: 'タグ', intro: '異なるテーマのあいだに繰り返し現れる言葉です。使用数の多い順に、記事同士の細かなつながりをたどれます。',
    tags: 'タグ数', posts: '件数',
    emptyTitle: 'タグはまだありません', empty: 'この言語で公開中のタグはまだありません。',
    crosslink: 'より大きなテーマから探すなら', categories: 'カテゴリーへ →',
    label: (name: string, count: number) => `${name}、${count} 件の記事`,
  },
  en: {
    title: 'Tags', intro: 'Words that recur across different subjects, ordered by use and tracing the finer links between posts.',
    tags: 'Tags', posts: 'Posts',
    emptyTitle: 'No tags yet', empty: 'There are no public tags in this language yet.',
    crosslink: 'Prefer broader subjects?', categories: 'Browse categories →',
    label: (name: string, count: number) => `${name}, ${count} ${count === 1 ? 'post' : 'posts'}`,
  },
} as const;
const c = copy[lang];
---

<BaseLayout lang={lang} title={c.title}>
  <section class="measure measure--media page-head">
    <h1>{c.title}</h1>
    <p class="page-head__lede">{c.intro}</p>
    <dl class="page-head__facts">
      <div><dt>{c.tags}</dt><dd>{String(tagEntries.length).padStart(2, '0')}</dd></div>
      <div><dt>{c.posts}</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div>
    </dl>
  </section>

  {tagEntries.length > 0 ? (
    <section class="measure measure--media band">
      <nav class="tag-field" aria-label={ui.nav.tags}>
        {tagEntries.map(({ name, count }) => (
          <a
            href={`/${lang}/tags/${encodeURIComponent(name)}/`}
            style={`--tag-size: ${tagSize(count)}`}
            aria-label={c.label(name, count)}
          >
            <span># {name}</span><small>{String(count).padStart(2, '0')}</small>
          </a>
        ))}
      </nav>
      <p class="crosslink">{c.crosslink} <a href={`/${lang}/categories/`}>{c.categories}</a></p>
    </section>
  ) : (
    <section class="measure measure--media band empty-state" aria-labelledby="tags-empty-title">
      <h2 id="tags-empty-title">{c.emptyTitle}</h2>
      <p>{c.empty}</p>
      <p class="crosslink">{c.crosslink} <a href={`/${lang}/categories/`}>{c.categories}</a></p>
    </section>
  )}
</BaseLayout>
