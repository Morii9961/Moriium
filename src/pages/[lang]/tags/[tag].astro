---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { getListedPosts } from '../../../utils/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of SITE.languages) {
    const posts = await getListedPosts(lang);
    const tags = new Set(posts.flatMap((post) => post.data.tags));
    for (const tag of tags) paths.push({ params: { lang, tag }, props: { lang, tag } });
  }
  return paths;
}

const { lang, tag } = Astro.props as { lang: Language; tag: string };
const posts = (await getListedPosts(lang)).filter((post) => post.data.tags.includes(tag));
const count = lang === 'zh' ? `${posts.length} 篇文章` : lang === 'ja' ? `${posts.length} 件` : `${posts.length} posts`;
---

<BaseLayout lang={lang} title={tag}>
  <header class="site-shell page-heading">
    <p class="page-heading__eyebrow">{UI[lang].nav.tags}</p>
    <h1>{tag}</h1>
    <p>{count}</p>
  </header>
  <section class="site-shell"><PostList posts={posts} lang={lang} /></section>
</BaseLayout>
