---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TaxonomyPostList from '../../../components/TaxonomyPostList.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { formatDate, getListedPosts } from '../../../utils/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const lang of SITE.languages) {
    const posts = await getListedPosts(lang);
    const tags = new Set(posts.flatMap((post) => post.data.tags));
    for (const tag of tags) paths.push({ params: { lang, tag }, props: { lang, tag } });
  }
  return paths;
};

const { lang, tag } = Astro.props as { lang: Language; tag: string };
const posts = (await getListedPosts(lang)).filter((post) => post.data.tags.includes(tag));
const ui = UI[lang];
const latest = posts[0];
if (!latest) throw new Error(`Tag "${tag}" has no listed posts.`);

const copy = {
  zh: {
    kicker: 'Index / Tag', intro: `带有“${tag}”标签的文章，按发布时间从新到旧排列。`, posts: '文章', updated: '最近更新',
    entries: (count: number) => `${String(count).padStart(2, '0')} 篇`, back: '返回全部标签 ←', tags: '标签',
  },
  ja: {
    kicker: 'Index / Tag', intro: `「${tag}」タグの記事を、公開日の新しい順に並べています。`, posts: '記事', updated: '最終更新',
    entries: (count: number) => `${String(count).padStart(2, '0')} 件`, back: 'タグ一覧へ戻る ←', tags: 'タグ',
  },
  en: {
    kicker: 'Index / Tag', intro: `Posts tagged “${tag}”, ordered from newest to oldest.`, posts: 'Posts', updated: 'Latest update',
    entries: (count: number) => `${String(count).padStart(2, '0')} ${count === 1 ? 'post' : 'posts'}`, back: 'Back to all tags ←', tags: 'Tags',
  },
} as const;
const c = copy[lang];
---

<BaseLayout lang={lang} title={tag}>
  <div class="a-directory">
    <header class="a-directory__hero">
      <p class="prototype-kicker">{c.kicker}</p>
      <div class="a-directory__title"><h1>{tag}</h1><p>{c.intro}</p></div>
      <dl class="a-directory__stats">
        <div><dt>{c.posts}</dt><dd>{c.entries(posts.length)}</dd></div>
        <div><dt>{c.updated}</dt><dd><time datetime={latest.data.publishedAt.toISOString()}>{formatDate(latest.data.publishedAt, ui.locale)}</time></dd></div>
      </dl>
    </header>

    <TaxonomyPostList posts={posts} lang={lang} heading={`# ${tag}`} countLabel={c.entries(posts.length)} tagsLabel={c.tags} />

    <p class="a-directory__crosslink"><a href={`/${lang}/tags/`}>{c.back}</a></p>
  </div>
</BaseLayout>
