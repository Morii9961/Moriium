---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/public-home.css';
import { SITE, UI, type Language } from '../../data/site';
import { formatDate, getListedPosts, postPath, uniqueTaxonomy } from '../../utils/content';

export function getStaticPaths() {
  return SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const posts = await getListedPosts(lang);
const recentPosts = posts.slice(0, 4);
const categories = uniqueTaxonomy(posts, 'category').map((name) => ({
  name,
  count: posts.filter((post) => post.data.category === name).length,
}));
const tags = uniqueTaxonomy(posts, 'tags').slice(0, 8);

const heroTitle = [
  {
    line: 'primary',
    glyphs: [
      ['見', 'solid'],
      ['た', 'solid'],
      ['も', 'solid'],
      ['の', 'solid'],
      ['を', 'outline'],
      ['記', 'bridge'],
      ['す', 'bridge'],
      ['。', 'bridge'],
    ],
  },
  {
    line: 'secondary',
    glyphs: [
      ['未', 'solid'],
      ['完', 'solid'],
      ['の', 'solid'],
      ['ま', 'solid'],
      ['ま', 'solid'],
      ['残', 'bridge'],
      ['す', 'bridge'],
      ['。', 'bridge'],
    ],
  },
] as const;

const heroCopy = {
  register: 'Moriium / 個人アーカイブ',
  title: '見たものを記す。未完のまま残す。',
  leftNote: '時間の中で、拾い集める。',
  rightNote: 'いつか戻れるように。',
  identity: '文字・写真・旅の記録',
  languages: 'ZH · JA · EN',
  body: '文字と写真と旅の断片を、ここでゆっくりと整理していく。',
  enter: '記事を読む',
} as const;

const copy = {
  zh: {
    routes: [
      ['Writing', '写下的', '全部公开文章'],
      ['Archive', '回看的', '按年份寻找'],
      ['Subjects', '反复出现的', '分类与标签'],
      ['About', '这个地方', 'Moriium 是什么'],
    ],
    recent: '前几页', recentNote: '最近公开、但不必立刻读完的文字。', all: '查看全部',
    field: '内容星图', fieldNote: '分类是较大的方向，标签是文章之间偶然形成的连线。',
    category: '主要方向', tags: '交叉索引', posts: (count: number) => `${count} 篇`,
    allCategories: '全部分类', allTags: '全部标签',
    now: '此刻仍在发生', nowNote: '还没有写成长文，但已经留下时间。',
    nowItems: [
      ['2026.08', '重做 Moriium', '先改变人与内容相遇的方式，再决定哪些功能值得留下。'],
      ['2026.08', '整理日本旅行照片', '路线与现场笔记都还在，等照片理顺后再写。'],
    ],
    closing: '下一页没有预告。',
    closingText: '你可以从文章进入，也可以从年份、主题或 RSS 以后再回来。这里不要求连续阅读。',
    archive: '打开归档', rss: '订阅 RSS', about: '关于这里',
  },
  ja: {
    routes: [
      ['Writing', '書いたもの', '公開中の記事'],
      ['Archive', '振り返るもの', '年から探す'],
      ['Subjects', '繰り返すもの', 'カテゴリーとタグ'],
      ['About', 'この場所', 'Moriium について'],
    ],
    recent: '前の頁', recentNote: '最近公開した、急いで読み終えなくてもよい文章。', all: 'すべて見る',
    field: '内容の星図', fieldNote: 'カテゴリーは大きな方向、タグは記事のあいだに偶然生まれた線です。',
    category: '主な方向', tags: '交差する索引', posts: (count: number) => `${count} 件`,
    allCategories: 'カテゴリー一覧', allTags: 'タグ一覧',
    now: 'まだ途中にあること', nowNote: '長い文章にはなっていませんが、時間はすでに残っています。',
    nowItems: [
      ['2026.08', 'Moriium を作り直す', '内容との出会い方を変えてから、残す機能を決めます。'],
      ['2026.08', '日本旅行の写真を整理中', 'ルートと現地のメモは残っています。写真が整ったら書きます。'],
    ],
    closing: '次の頁に予告はありません。',
    closingText: '記事、年、テーマ、RSS。どの入口からでも、あとで戻って来られます。続けて読む必要はありません。',
    archive: 'アーカイブを開く', rss: 'RSS を購読', about: 'この場所について',
  },
  en: {
    routes: [
      ['Writing', 'Things written', 'Every public post'],
      ['Archive', 'Things revisited', 'Find a year'],
      ['Subjects', 'Things recurring', 'Categories and tags'],
      ['About', 'This place', 'What Moriium is'],
    ],
    recent: 'Previous pages', recentNote: 'Recently published writing that does not ask to be finished at once.', all: 'See all writing',
    field: 'A map of the work', fieldNote: 'Categories mark broad directions; tags are lines that happen to form between posts.',
    category: 'Main directions', tags: 'Cross-index', posts: (count: number) => `${count} ${count === 1 ? 'post' : 'posts'}`,
    allCategories: 'All categories', allTags: 'All tags',
    now: 'Still in progress', nowNote: 'Not long enough to be an essay, but already part of the record.',
    nowItems: [
      ['2026.08', 'Rebuilding Moriium', 'Change how people encounter the work first; decide which features deserve to remain later.'],
      ['2026.08', 'Sorting the Japan photographs', 'The route and field notes remain. I will write after the photographs are in order.'],
    ],
    closing: 'The next page is unannounced.',
    closingText: 'Enter through a post, a year, a subject, or return later by RSS. Nothing here has to be read in sequence.',
    archive: 'Open the archive', rss: 'Subscribe by RSS', about: 'About this place',
  },
} as const;
const c = copy[lang];
const routeHrefs = [`/${lang}/writing/`, `/${lang}/archive/`, `/${lang}/categories/`, `/${lang}/about/`];
---

<BaseLayout lang={lang}>
  <div class="aperture-home">
    <section class="aperture-hero" aria-labelledby="home-title">
      <p class="aperture-hero__register" lang="ja">{heroCopy.register}<span>{String(posts.length).padStart(2, '0')} / {heroCopy.languages}</span></p>

      <span class="aperture-hero__fragment aperture-hero__fragment--one" aria-hidden="true">記録</span>
      <span class="aperture-hero__fragment aperture-hero__fragment--two" aria-hidden="true">残る</span>
      <span class="aperture-hero__fragment aperture-hero__fragment--three" aria-hidden="true">戻る</span>
      <p class="aperture-hero__note aperture-hero__note--left" lang="ja" aria-hidden="true">{heroCopy.leftNote}</p>
      <p class="aperture-hero__note aperture-hero__note--right" lang="ja" aria-hidden="true">{heroCopy.rightNote}</p>

      <div class="aperture-hero__thesis">
        <h1 id="home-title" lang="ja" aria-label={heroCopy.title}>
          {heroTitle.map(({ line, glyphs }) => (
            <span class={`aperture-hero__phrase aperture-hero__phrase--${line}`} aria-hidden="true">
              {glyphs.map(([glyph, treatment], index) => (
                <span class={`aperture-hero__glyph aperture-hero__glyph--${treatment} aperture-hero__glyph--${index + 1}`}>{glyph}</span>
              ))}
            </span>
          ))}
        </h1>
      </div>

      <div class="aperture-hero__window">
        <span class="aperture-hero__shutter" aria-hidden="true"></span>
        <div class="aperture-identity">
          <p class="aperture-identity__register" lang="ja"><span>{heroCopy.identity}</span><span>{heroCopy.languages}</span></p>
          <div class="aperture-identity__body">
            <h2 lang="en">Moriium</h2>
            <p lang="ja">{heroCopy.body}</p>
          </div>
          <a href={`/${lang}/writing/`} lang="ja"><span>{heroCopy.enter}</span><i aria-hidden="true">↗</i></a>
        </div>
      </div>

      <div class="aperture-hero__overprint" aria-hidden="true">
        {heroTitle.map(({ line, glyphs }) => (
          <span class={`aperture-hero__phrase aperture-hero__phrase--${line}`}>
            {glyphs.map(([glyph, treatment], index) => (
              <span class={`aperture-hero__glyph aperture-hero__glyph--${treatment} aperture-hero__glyph--${index + 1}`}>{glyph}</span>
            ))}
          </span>
        ))}
      </div>
    </section>

    <nav class="aperture-ways" aria-label={ui.primaryNav}>
      {c.routes.map(([label, title, note], index) => (
        <a href={routeHrefs[index]}>
          <small>{label}</small><span>{title}</span><i>{note}</i><b aria-hidden="true">↗</b>
        </a>
      ))}
    </nav>

    {recentPosts.length > 0 && (
      <section class="aperture-recent" aria-labelledby="home-recent-title">
        <header><p>Writing / Recent</p><h2 id="home-recent-title">{c.recent}</h2><span>{c.recentNote}</span></header>
        <ol>
          {recentPosts.map((post) => (
            <li><a href={postPath(post)}>
              <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, ui.locale)}</time>
              <h3>{post.data.title}</h3><p>{post.data.summary}</p><i aria-hidden="true">↗</i>
            </a></li>
          ))}
        </ol>
        <a class="aperture-text-link" href={`/${lang}/writing/`}>{c.all} →</a>
      </section>
    )}

    <section class="aperture-field" aria-labelledby="home-field-title">
      <header>
        <p>Index / Coordinates</p>
        <h2 id="home-field-title">{c.field}</h2>
        <span>{c.fieldNote}</span>
      </header>
      <div class="aperture-field__body">
        <section aria-labelledby="home-categories-title">
          <div class="aperture-field__label"><h3 id="home-categories-title">{c.category}</h3><a href={`/${lang}/categories/`}>{c.allCategories} ↗</a></div>
          <ol>{categories.map((category) => <li><a href={`/${lang}/categories/${encodeURIComponent(category.name)}/`}><span>{category.name}</span><small>{c.posts(category.count)}</small></a></li>)}</ol>
        </section>
        <section class="aperture-field__tags" aria-labelledby="home-tags-title">
          <div class="aperture-field__label"><h3 id="home-tags-title">{c.tags}</h3><a href={`/${lang}/tags/`}>{c.allTags} ↗</a></div>
          <div>{tags.map((tag, index) => <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`} style={`--tag-offset: ${index}`}># {tag}</a>)}</div>
        </section>
      </div>
    </section>

    <section class="aperture-now" aria-labelledby="home-now-title">
      <header><p>Now / 2026.08</p><h2 id="home-now-title">{c.now}</h2><span>{c.nowNote}</span></header>
      <ol>{c.nowItems.map(([date, title, note]) => <li><time>{date}</time><div><h3>{title}</h3><p>{note}</p></div></li>)}</ol>
    </section>

    <section class="aperture-closing" aria-labelledby="home-closing-title">
      <p>Moriium / Continue later</p>
      <h2 id="home-closing-title">{c.closing}</h2>
      <div><p>{c.closingText}</p><nav aria-label={c.about}><a href={`/${lang}/archive/`}>{c.archive}</a><a href={`/${lang}/rss.xml`}>{c.rss}</a><a href={`/${lang}/about/`}>{c.about}</a></nav></div>
    </section>
  </div>
</BaseLayout>
