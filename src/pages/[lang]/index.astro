---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/public-home.css';
import { SITE, UI, type Language } from '../../data/site';
import { formatDate, getListedPosts, postPath, uniqueTaxonomy } from '../../utils/content';

export function getStaticPaths() {
  return SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const posts = await getListedPosts(lang);
const recentPosts = posts.slice(0, 4);
const categories = uniqueTaxonomy(posts, 'category').map((name) => ({
  name,
  count: posts.filter((post) => post.data.category === name).length,
}));
const tags = uniqueTaxonomy(posts, 'tags').slice(0, 8);

// The ledger is derived entirely from the posts, so it cannot go stale the way
// a hand-written "currently" list does. Years descend; the oldest post sets the
// date the archive starts from.
const yearGroups = [...Map.groupBy(posts, (post) => post.data.publishedAt.getFullYear()).entries()].sort(
  ([a], [b]) => b - a,
);
const oldestPost = posts.at(-1);
const startedLabel = oldestPost
  ? new Intl.DateTimeFormat(ui.locale, { year: 'numeric', month: 'long' }).format(oldestPost.data.publishedAt)
  : '—';

// Calendar: show the most recent month that has a post, falling back to now.
const calendarAnchor = posts[0]?.data.publishedAt ?? new Date();
const calendarYear = calendarAnchor.getFullYear();
const calendarMonth = calendarAnchor.getMonth(); // 0-indexed
const daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
const firstWeekday = new Date(calendarYear, calendarMonth, 1).getDay(); // 0=Sun
const activeDays = new Set(
  posts
    .filter((p) => {
      const d = p.data.publishedAt;
      return d.getFullYear() === calendarYear && d.getMonth() === calendarMonth;
    })
    .map((p) => p.data.publishedAt.getDate()),
);
const calendarLabel = new Intl.DateTimeFormat(ui.locale, { year: 'numeric', month: 'long' }).format(
  new Date(calendarYear, calendarMonth, 1),
);
const calendarRecentPosts = posts
  .filter((p) => {
    const d = p.data.publishedAt;
    return d.getFullYear() === calendarYear && d.getMonth() === calendarMonth;
  })
  .slice(0, 3);

// Four runs, and each one is a single line of type — not a row of individually
// placed characters. Every glyph in a run shares one font-size, one line box and
// one baseline, which is what makes the em-box top edges and bottom edges of a
// run land on two exactly parallel lines. Nothing here carries a per-glyph size,
// angle or vertical offset, and nothing should: the moment one character gets
// its own `top` or `rotate`, those two edges break and the run stops reading as
// a line and starts reading as five decorations.
//
// Three per-glyph values, all deliberately narrow:
//
// `nudge` is horizontal spacing, in em against the run's own font-size, spent as
// `margin-left` — layout, not transform. A margin moves the character along the
// run's own axis inside the shared line box, so the two em-box edges stay where
// they were. A `translateX` would need each glyph to be its own box.
//
// `at` and `drift` belong to the entrance only and leave nothing behind: `at` is
// when this character starts, in ms after its run begins, and `drift` is a tiny
// sideways offset it travels in from, in em.
//
// The `at` values are uneven on purpose, and the unevenness is not decoration.
// An even step reads as a machine counting off characters. These are grouped
// into the breaths the phrase actually has — 見た | もの | を and 未完 | のまま —
// with a short rest between groups and a tighter step inside one, so the run
// reads as writing rather than as a list. 見 and 未 anchor their runs and do not
// drift at all; the kana after them do.
//
// A glyph may otherwise differ from its neighbours in colour and stroke only.
// `を` is set as an outline but still belongs to 見たもの's line box, so it keeps
// that run's baseline rather than becoming a fifth object with a position of its
// own — and it enters on that run's schedule, not with the outline runs.
//
// The rest of the geometry lives in the stylesheet: the run rotates, an inner
// wrapper shears. See `.aperture-hero__phrase` in public-home.css.
const heroTitle = [
  {
    line: 'primary',
    glyphs: [
      { char: '見', treatment: 'solid', nudge: 0, at: 0, drift: 0 },
      { char: 'た', treatment: 'solid', nudge: 0.055, at: 85, drift: -0.03 },
      { char: 'も', treatment: 'solid', nudge: 0.045, at: 250, drift: 0.025 },
      { char: 'の', treatment: 'solid', nudge: 0.055, at: 330, drift: -0.02 },
      { char: 'を', treatment: 'outline', nudge: -0.055, at: 480, drift: 0.035 },
    ],
  },
  {
    line: 'primary-echo',
    glyphs: [
      { char: '記', treatment: 'outline', nudge: 0, at: 0, drift: 0.02 },
      { char: 'す', treatment: 'outline', nudge: 0.041, at: 150, drift: -0.025 },
      { char: '。', treatment: 'outline', nudge: 0.025, at: 330, drift: 0.03 },
    ],
  },
  {
    line: 'secondary',
    glyphs: [
      { char: '未', treatment: 'solid', nudge: 0, at: 0, drift: 0 },
      { char: '完', treatment: 'solid', nudge: 0.055, at: 80, drift: 0.02 },
      { char: 'の', treatment: 'solid', nudge: 0.045, at: 230, drift: -0.018 },
      { char: 'ま', treatment: 'solid', nudge: 0.055, at: 305, drift: 0.022 },
      { char: 'ま', treatment: 'solid', nudge: 0.045, at: 375, drift: -0.015 },
    ],
  },
  {
    line: 'secondary-echo',
    glyphs: [
      { char: '残', treatment: 'outline', nudge: 0, at: 0, drift: 0.02 },
      { char: 'す', treatment: 'outline', nudge: 0.041, at: 140, drift: -0.025 },
      { char: '。', treatment: 'outline', nudge: 0.025, at: 310, drift: 0.03 },
    ],
  },
] as const;

// Background texture only. `ink` is the percentage of ink mixed into the canvas,
// so no fragment reaches a tenth of the page contrast.
const heroFragments = [
  { char: '残る', x: 36, y: -1.6, size: 3.1, ink: 7, fuzz: 0.7, tier: 'wide' },
  { char: '戻る', x: 95.1, y: 16, size: 3.5, ink: 11, fuzz: 0.4, tier: 'wide' },
  { char: '記録', x: 15, y: 44, size: 2.9, ink: 8, fuzz: 0.9, tier: 'core' },
  { char: '旅の断片', x: 98.5, y: 63, size: 1.4, ink: 6, fuzz: 0.7, tier: 'wide' },
  { char: '拾い集める', x: 1.1, y: 11.5, size: 0.72, ink: 9, fuzz: 0.3, tier: 'core' },
  { char: '未完のまま', x: 26, y: 61, size: 0.68, ink: 7, fuzz: 0.4, tier: 'core' },
  { char: 'いつか戻る', x: 97.5, y: 88, size: 0.68, ink: 8, fuzz: 0.3, tier: 'wide' },
] as const;

// The display type is Japanese in every language: it is the hero's image, read
// as form rather than as a sentence, and `aria-label` on the h1 carries the
// text for anyone not reading it visually. The panel's own copy is a different
// thing — ordinary prose the reader is meant to read — so it is localised in
// `copy` below and follows the page language.
const heroCopy = {
  title: '見たものを記す。未完のまま残す。',
  leftNote: '時間の中で、拾い集める。',
  rightNote: 'いつか戻れるように。',
} as const;

const copy = {
  zh: {
    heroIdentity: '文字・照片・旅途的记录',
    heroBody: ['文字、照片与旅途的断片，', '在这里慢慢地整理。'],
    routes: [
      ['Writing', '写下的', '全部公开文章'],
      ['Archive', '回看的', '按年份寻找'],
      ['Subjects', '反复出现的', '分类与标签'],
      ['About', '这个地方', 'Moriium 是什么'],
    ],
    recent: '前几页', recentNote: '最近公开、但不必立刻读完的文字。', all: '查看全部',
    field: '内容星图', fieldNote: '分类是较大的方向，标签是文章之间偶然形成的连线。',
    category: '主要方向', tags: '交叉索引', posts: (count: number) => `${count} 篇`,
    allCategories: '全部分类', allTags: '全部标签',
    ledger: '存了些什么', ledgerNote: '按年份看，以及这个档案从什么时候开始。',
    ledgerYears: '年份', ledgerEntries: (count: number) => `${count} 篇`,
    factStarted: '开始于', factPosts: '文章',
    colophon: '关于这里',
    colophonNote: '谁在写，什么时候更新过。',
    authorTitle: '维护者',
    authorNames: 'Morii & Enouia',
    people: [
      ['Morii', '写文章，拍照片。路上的见闻也放在这里。'],
      ['Enouia', '整理内容，也负责把网站搭起来、照看好。'],
    ],
    authorAbout: '关于',
    calendarTitle: '更新日历',
    calendarWeekdays: ['日', '一', '二', '三', '四', '五', '六'],
    calendarDayActive: (day: number) => `${day}日有文章更新`,
    fullArchive: '完整归档',
    rss: '订阅 RSS', about: '关于 Moriium',
  },
  ja: {
    heroIdentity: '文字・写真・旅の記録',
    heroBody: ['文字と写真と旅の断片を、', 'ここでゆっくりと整理していく。'],
    routes: [
      ['Writing', '書いたもの', '公開中の記事'],
      ['Archive', '振り返るもの', '年から探す'],
      ['Subjects', '繰り返すもの', 'カテゴリーとタグ'],
      ['About', 'この場所', 'Moriium について'],
    ],
    recent: '前の頁', recentNote: '最近公開した、急いで読み終えなくてもよい文章。', all: 'すべて見る',
    field: '内容の星図', fieldNote: 'カテゴリーは大きな方向、タグは記事のあいだに偶然生まれた線です。',
    category: '主な方向', tags: '交差する索引', posts: (count: number) => `${count} 件`,
    allCategories: 'カテゴリー一覧', allTags: 'タグ一覧',
    ledger: '残っているもの', ledgerNote: '年ごとの記事と、このアーカイブが始まった時期。',
    ledgerYears: '年', ledgerEntries: (count: number) => `${count} 件`,
    factStarted: '開始', factPosts: '記事',
    colophon: 'この場所について',
    colophonNote: '誰が書いているか、いつ更新されたか。',
    authorTitle: '運営',
    authorNames: 'Morii & Enouia',
    people: [
      ['Morii', '文章を書き、写真を撮る。旅の記録もここに置いています。'],
      ['Enouia', '内容を整理し、サイトの構築と管理を担当しています。'],
    ],
    authorAbout: 'について',
    calendarTitle: '更新カレンダー',
    calendarWeekdays: ['日', '月', '火', '水', '木', '金', '土'],
    calendarDayActive: (day: number) => `${day}日に記事が更新されました`,
    fullArchive: 'アーカイブ',
    rss: 'RSS を購読', about: 'Moriium について',
  },
  en: {
    heroIdentity: 'Words · Photographs · Travel',
    heroBody: ['Fragments of writing, photographs', 'and travel, gathered here slowly.'],
    routes: [
      ['Writing', 'Things written', 'Every public post'],
      ['Archive', 'Things revisited', 'Find a year'],
      ['Subjects', 'Things recurring', 'Categories and tags'],
      ['About', 'This place', 'What Moriium is'],
    ],
    recent: 'Previous pages', recentNote: 'Recently published writing that does not ask to be finished at once.', all: 'See all writing',
    field: 'A map of the work', fieldNote: 'Categories mark broad directions; tags are lines that happen to form between posts.',
    category: 'Main directions', tags: 'Cross-index', posts: (count: number) => `${count} ${count === 1 ? 'post' : 'posts'}`,
    allCategories: 'All categories', allTags: 'All tags',
    ledger: 'What is kept here', ledgerNote: 'By year, and when this archive starts from.',
    ledgerYears: 'Years', ledgerEntries: (count: number) => `${count} ${count === 1 ? 'entry' : 'entries'}`,
    factStarted: 'Started', factPosts: 'Posts',
    colophon: 'About this place',
    colophonNote: 'Who writes here, and when it was last updated.',
    authorTitle: 'Maintainers',
    authorNames: 'Morii & Enouia',
    people: [
      ['Morii', 'Writes and photographs. Travel notes end up here too.'],
      ['Enouia', 'Organises the content, and builds and looks after the site.'],
    ],
    authorAbout: 'About',
    calendarTitle: 'Update calendar',
    calendarWeekdays: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
    calendarDayActive: (day: number) => `Post updated on day ${day}`,
    fullArchive: 'Full archive',
    rss: 'Subscribe by RSS', about: 'About Moriium',
  },
} as const;
const c = copy[lang];
const routeHrefs = [`/${lang}/writing/`, `/${lang}/archive/`, `/${lang}/categories/`, `/${lang}/about/`];
---

<BaseLayout lang={lang}>
  <div class="aperture-home">
    <section class="aperture-hero" aria-labelledby="home-title">
      <div class="aperture-hero__stage">
        {heroFragments.map((fragment) => (
          <span
            class={`aperture-hero__fragment aperture-hero__fragment--${fragment.tier}`}
            style={`--x:${fragment.x};--y:${fragment.y};--size:${fragment.size};--ink-share:${fragment.ink};--fuzz:${fragment.fuzz}`}
            aria-hidden="true"
          >{fragment.char}</span>
        ))}

        <span class="aperture-hero__rule aperture-hero__rule--left" aria-hidden="true"></span>
        <span class="aperture-hero__rule aperture-hero__rule--right" aria-hidden="true"></span>
        <p class="aperture-hero__note aperture-hero__note--left" lang="ja" aria-hidden="true">{heroCopy.leftNote}</p>
        <p class="aperture-hero__note aperture-hero__note--right" lang="ja" aria-hidden="true">{heroCopy.rightNote}</p>

        <div class="aperture-hero__thesis">
          <h1 id="home-title" lang="ja" aria-label={heroCopy.title}>
            {heroTitle.map(({ line, glyphs }) => (
              <span class={`aperture-hero__phrase aperture-hero__phrase--${line}`} aria-hidden="true">
                <span class="aperture-hero__slant">
                  {glyphs.map(({ char, treatment, nudge, at, drift }) => (
                    <span
                      class={`aperture-hero__glyph aperture-hero__glyph--${treatment}`}
                      style={`--nudge:${nudge};--at:${at};--drift:${drift}`}
                    >{char}</span>
                  ))}
                </span>
              </span>
            ))}
          </h1>
        </div>

        <div class="aperture-hero__window">
          <span class="aperture-hero__shutter" aria-hidden="true"></span>
          <span class="aperture-hero__corner" aria-hidden="true"></span>
          <div class="aperture-identity">
            <p class="aperture-identity__register">{c.heroIdentity}</p>
            <div class="aperture-identity__body">
              <h2 lang="en">Moriium</h2>
              <p>{c.heroBody.map((line) => <span>{line}</span>)}</p>
            </div>
            <a href={`/${lang}/writing/`}><span>{ui.read}</span><i aria-hidden="true">↗</i></a>
          </div>
        </div>

        <div class="aperture-hero__overprint" aria-hidden="true">
          {heroTitle.map(({ line, glyphs }) => (
            <span class={`aperture-hero__phrase aperture-hero__phrase--${line}`}>
              <span class="aperture-hero__slant">
                {glyphs.map(({ char, treatment, nudge, at, drift }) => (
                  <span
                    class={`aperture-hero__glyph aperture-hero__glyph--${treatment}`}
                    style={`--nudge:${nudge};--at:${at};--drift:${drift}`}
                  >{char}</span>
                ))}
              </span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <nav class="aperture-ways" aria-label={ui.primaryNav}>
      {c.routes.map(([label, title, note], index) => (
        <a href={routeHrefs[index]}>
          <small>{label}</small><span>{title}</span><i>{note}</i><b aria-hidden="true">↗</b>
        </a>
      ))}
    </nav>

    {recentPosts.length > 0 && (
      <section class="aperture-recent" aria-labelledby="home-recent-title">
        <header><p>Writing / Recent</p><h2 id="home-recent-title">{c.recent}</h2><span>{c.recentNote}</span></header>
        <ol>
          {recentPosts.map((post) => (
            <li><a href={postPath(post)}>
              <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, ui.locale)}</time>
              <h3>{post.data.title}</h3><p>{post.data.summary}</p><i aria-hidden="true">↗</i>
            </a></li>
          ))}
        </ol>
        <a class="aperture-action aperture-recent__more" href={`/${lang}/writing/`}>
          <span>{c.all}</span><i aria-hidden="true">↗</i>
        </a>
      </section>
    )}

    <section class="aperture-field" aria-labelledby="home-field-title">
      <header>
        <p>Index / Coordinates</p>
        <h2 id="home-field-title">{c.field}</h2>
        <span>{c.fieldNote}</span>
      </header>
      <div class="aperture-field__body">
        <section aria-labelledby="home-categories-title">
          <div class="aperture-field__label"><h3 id="home-categories-title">{c.category}</h3><a class="aperture-action" href={`/${lang}/categories/`}><span>{c.allCategories}</span><i aria-hidden="true">↗</i></a></div>
          <ol>{categories.map((category) => <li><a href={`/${lang}/categories/${encodeURIComponent(category.name)}/`}><span>{category.name}</span><small>{c.posts(category.count)}</small></a></li>)}</ol>
        </section>
        <section class="aperture-field__tags" aria-labelledby="home-tags-title">
          <div class="aperture-field__label"><h3 id="home-tags-title">{c.tags}</h3><a class="aperture-action" href={`/${lang}/tags/`}><span>{c.allTags}</span><i aria-hidden="true">↗</i></a></div>
          <div>{tags.map((tag, index) => <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`} style={`--tag-offset: ${index}`}># {tag}</a>)}</div>
        </section>
      </div>
    </section>

    <section class="aperture-ledger" aria-labelledby="home-ledger-title">
      <header><p>Archive / Ledger</p><h2 id="home-ledger-title">{c.ledger}</h2><span>{c.ledgerNote}</span></header>
      <div class="aperture-ledger__body">
        {yearGroups.length > 0 && (
          <ol class="aperture-ledger__years" aria-label={c.ledgerYears}>
            {yearGroups.map(([year, entries]) => (
              <li>
                <a href={`/${lang}/archive/#archive-${year}`}>
                  <span>{year}</span>
                  <small>{c.ledgerEntries(entries.length)}</small>
                </a>
              </li>
            ))}
          </ol>
        )}
        <dl class="aperture-ledger__facts">
          <div><dt>{c.factStarted}</dt><dd>{startedLabel}</dd></div>
          <div><dt>{c.factPosts}</dt><dd>{c.ledgerEntries(posts.length)}</dd></div>
        </dl>
      </div>
    </section>

    <section class="aperture-colophon" aria-labelledby="home-colophon-title">
      <header>
        <p>Moriium / Colophon</p>
        <h2 id="home-colophon-title">{c.colophon}</h2>
        <span>{c.colophonNote}</span>
      </header>

      <div class="aperture-colophon__body">
        <div class="aperture-colophon__author">
          <div class="aperture-colophon__author-head">
            <h3>{c.authorTitle}</h3>
            <span>{c.authorNames}</span>
          </div>
          <ol class="aperture-colophon__people">
            {c.people.map(([name, role]) => (
              <li>
                <h4>{name}</h4>
                <p>{role}</p>
              </li>
            ))}
          </ol>
          <nav class="aperture-colophon__actions" aria-label={c.authorAbout}>
            <a class="aperture-action" href={`/${lang}/about/`}>
              <span>{c.about}</span><i aria-hidden="true">↗</i>
            </a>
            <a class="aperture-action" href="https://github.com/Morii9961">
              <span>GitHub</span><i aria-hidden="true">↗</i>
            </a>
            <a class="aperture-action" href={`/${lang}/rss.xml`}>
              <span>{c.rss}</span><i aria-hidden="true">↗</i>
            </a>
          </nav>
        </div>

        <div class="aperture-colophon__calendar">
          <div class="aperture-colophon__calendar-head">
            <h3>{c.calendarTitle}</h3>
            <span>{calendarLabel}</span>
          </div>
          <div class="aperture-calendar" aria-label={`${c.calendarTitle}: ${calendarLabel}`}>
            <div class="aperture-calendar__week" aria-hidden="true">
              {c.calendarWeekdays.map((d) => <span>{d}</span>)}
            </div>
            <div class="aperture-calendar__days">
              {Array.from({ length: firstWeekday }).map(() => <span aria-hidden="true"></span>)}
              {Array.from({ length: daysInMonth }, (_, i) => i + 1).map((day) =>
                activeDays.has(day)
                  ? <time class="is-active" datetime={`${calendarYear}-${String(calendarMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`} title={c.calendarDayActive(day)}>{day}<i aria-hidden="true"></i></time>
                  : <time datetime={`${calendarYear}-${String(calendarMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`}>{day}</time>
              )}
            </div>
          </div>
          {calendarRecentPosts.length > 0 && (
            <ol class="aperture-colophon__latest">
              {calendarRecentPosts.map((post) => (
                <li>
                  <a href={postPath(post)}>{post.data.title}</a>
                  <time>{`${String(calendarMonth + 1).padStart(2, '0')}/${String(post.data.publishedAt.getDate()).padStart(2, '0')}`}</time>
                </li>
              ))}
            </ol>
          )}
          <div class="aperture-colophon__actions aperture-colophon__actions--single">
            <a class="aperture-action" href={`/${lang}/archive/`}>
              <span>{c.fullArchive}</span><i aria-hidden="true">↗</i>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
