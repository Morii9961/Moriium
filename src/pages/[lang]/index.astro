---
/*
 * The home page.
 *
 * DESIGN.md 8.2 calls this a curated editorial index rather than a feature
 * dashboard, so it is a sequence of bands that widen, narrow, and widen again:
 * gallery for the opening, media for the lead story and the recent writing,
 * the reading measure for the personal note at the centre, then media and
 * gallery on the way back out. The rule that opens each band is exactly as wide
 * as the band, so the arc is visible as you scroll and no section needs a card
 * or a panel to show where it begins.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostLedger from '../../components/PostLedger.astro';
import SectionMark from '../../components/SectionMark.astro';
import { SITE, UI, type Language } from '../../data/site';
import { getListedPosts, postPath, uniqueTaxonomy } from '../../utils/content';

export function getStaticPaths() {
  return SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const posts = await getListedPosts(lang);
const lead = posts[0];
const recent = posts.slice(1, 6);
const categories = uniqueTaxonomy(posts, 'category').map((name) => ({
  name,
  count: posts.filter((post) => post.data.category === name).length,
}));
const tags = uniqueTaxonomy(posts, 'tags');
const leadCover = lead?.collection === 'posts' ? lead.data.cover : undefined;
const leadCoverAlt = lead?.collection === 'posts' ? lead.data.coverAlt : undefined;

const longDate = new Intl.DateTimeFormat(ui.locale, { year: 'numeric', month: 'long', day: 'numeric' });
const shortDate = new Intl.DateTimeFormat(ui.locale, { month: '2-digit', day: '2-digit' });
const isoDay = (date: Date) => date.toISOString().slice(0, 10);

const copy = {
  zh: {
    thesis: ['想到什么，', '就慢慢写下来。'],
    intro:
      'Moriium 是我的个人博客。这里没有固定主题，也不赶更新；文章、照片和路上的见闻，想整理时就放进来。',
    enter: '看看文章',
    leadMark: '最新',
    writingMark: '文章',
    writingAll: '全部文章',
    nowMark: '近况',
    nowTitle: '最近在做的事',
    discoverMark: '索引',
    discoverTitle: '换个方式找',
    discoverNote: '按分类进入，或者从归档、标签、订阅里挑一条路。',
    colophonMark: '版本记录',
    countsTitle: '目前收录',
    updatesTitle: '最近更新',
    aboutTitle: 'Morii 与 Enouia',
    author:
      'Morii 写文章、拍照片；Enouia 整理内容，也负责把网站搭起来、照看好。',
    posts: '文章',
    categories: '分类',
    tags: '标签',
    languages: '语言',
    about: '关于',
    empty: '这个语言版本暂时没有可以公开列出的文章。',
    entryArchive: ['文章归档', '按年份翻看'],
    entryTags: ['标签索引', '按关键词查找'],
    entryRss: ['RSS 订阅', '有新文章时直接收到'],
    nowItems: [
      ['2026.08', '还在重做这个网站', '先把页面和写作流程理顺，功能一项一项补。'],
      ['2026.08', '日本旅行的照片还在整理', '路线和现场笔记都在，等照片理好再慢慢写。'],
    ],
  },
  ja: {
    thesis: ['思いついたことを、', 'ゆっくり書いていく。'],
    intro:
      'Moriium は私の個人ブログです。テーマも更新頻度も決めていません。文章や写真、旅先で見たことを、整理したくなったときに残します。',
    enter: '記事を見る',
    leadMark: '最新',
    writingMark: '記事',
    writingAll: 'すべての記事',
    nowMark: 'いま',
    nowTitle: '最近していること',
    discoverMark: '索引',
    discoverTitle: '別の探し方',
    discoverNote: 'カテゴリーから入るか、アーカイブ、タグ、購読のどれかをたどってください。',
    colophonMark: '奥付',
    countsTitle: '現在の収録',
    updatesTitle: '最近の更新',
    aboutTitle: 'Morii と Enouia',
    author:
      'Morii が文章を書き、写真を撮り、Enouia が内容を整理してサイトを整えます。',
    posts: '記事',
    categories: 'カテゴリー',
    tags: 'タグ',
    languages: '言語',
    about: 'このサイト',
    empty: 'この言語で公開中の記事はまだありません。',
    entryArchive: ['アーカイブ', '年ごとに見る'],
    entryTags: ['タグ索引', 'キーワードで探す'],
    entryRss: ['RSS', '新しい記事を受け取る'],
    nowItems: [
      ['2026.08', 'サイトを作り直しています', 'ページと執筆の流れを整え、機能を一つずつ追加しています。'],
      ['2026.08', '日本旅行の写真を整理中', 'ルートとメモは残っています。写真が整ったら少しずつ書きます。'],
    ],
  },
  en: {
    thesis: ['I write things down', 'when I feel like it.'],
    intro:
      'Moriium is my personal blog. It has no fixed subject or schedule. I use it for articles, photographs, and notes from the road.',
    enter: 'Read the posts',
    leadMark: 'Latest',
    writingMark: 'Writing',
    writingAll: 'All posts',
    nowMark: 'Now',
    nowTitle: 'What I am working on',
    discoverMark: 'Index',
    discoverTitle: 'Another way in',
    discoverNote: 'Start from a category, or take the archive, the tags, or the feed.',
    colophonMark: 'Colophon',
    countsTitle: 'Currently holding',
    updatesTitle: 'Recent updates',
    aboutTitle: 'Morii and Enouia',
    author:
      'Morii writes and takes photographs; Enouia organizes the work and looks after the site.',
    posts: 'Posts',
    categories: 'Categories',
    tags: 'Tags',
    languages: 'Languages',
    about: 'About',
    empty: 'There are no listed posts in this language yet.',
    entryArchive: ['Archive', 'Browse by year'],
    entryTags: ['Tag index', 'Find posts by keyword'],
    entryRss: ['RSS', 'Get new posts directly'],
    nowItems: [
      ['2026.08', 'Rebuilding this site', 'I am sorting out the pages and writing flow, then adding features one at a time.'],
      ['2026.08', 'Sorting the Japan photographs', 'The route and notes are ready. I will write when the photographs are in order.'],
    ],
  },
} as const;
const c = copy[lang];
---

<BaseLayout lang={lang}>
  <section class="measure measure--gallery opening" aria-labelledby="opening-title">
    <h1 class="opening__name" id="opening-title" lang="en" translate="no">{SITE.name}</h1>
    <hr class="opening__rule" />
    <p class="opening__thesis">{c.thesis[0]}<br />{c.thesis[1]}</p>
    <p class="opening__intro">{c.intro}</p>
    <a class="opening__entry" href={`/${lang}/writing/`}>
      {c.enter} <span aria-hidden="true">→</span>
    </a>
  </section>

  {lead ? (
    <>
      <section class="measure measure--media band" aria-labelledby="lead-title">
        <SectionMark label={c.leadMark} aside={longDate.format(lead.data.publishedAt)} lead />
        <h2 class="lead__title" id="lead-title"><a href={postPath(lead)}>{lead.data.title}</a></h2>
        <p class="lead__summary">{lead.data.summary}</p>
      </section>

      {leadCover && (
        <div class="measure measure--gallery">
          <figure class="plate">
            <a href={postPath(lead)}>
              <img src={leadCover} alt={leadCoverAlt ?? ''} loading="lazy" decoding="async" />
            </a>
            <figcaption>
              <span>{lead.data.category}</span>
              <span>{leadCoverAlt}</span>
            </figcaption>
          </figure>
        </div>
      )}

      {recent.length > 0 && (
        <section class="measure measure--media band" aria-labelledby="recent-title">
          <SectionMark
            label={c.writingMark}
            actionLabel={c.writingAll}
            actionHref={`/${lang}/writing/`}
          />
          <h2 class="band__heading" id="recent-title">{c.writingMark}</h2>
          <div class="band__body">
            <PostLedger posts={recent} lang={lang} labelledBy="recent-title" />
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="measure measure--media band">
      <SectionMark label={c.writingMark} />
      <p class="band__lede">{c.empty}</p>
    </section>
  )}

  <section class="measure measure--text band" aria-labelledby="now-title">
    <SectionMark label={c.nowMark} aside="2026.08" />
    <h2 class="band__heading" id="now-title">{c.nowTitle}</h2>
    <ol class="traces">
      {c.nowItems.map(([date, title, note]) => (
        <li>
          <time>{date}</time>
          <div>
            <h3>{title}</h3>
            <p>{note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="measure measure--media band" aria-labelledby="discover-title">
    <SectionMark label={c.discoverMark} aside={`${categories.length} / ${tags.length}`} />
    <h2 class="band__heading" id="discover-title">{c.discoverTitle}</h2>
    <p class="band__lede">{c.discoverNote}</p>

    {categories.length > 0 && (
      <ol class="category-index band__body">
        {categories.map((category) => (
          <li>
            <a href={`/${lang}/categories/${encodeURIComponent(category.name)}/`}>
              <span class="category-index__name">{category.name}</span>
              <span class="category-index__count">{String(category.count).padStart(2, '0')}</span>
            </a>
          </li>
        ))}
      </ol>
    )}

    <div class="entries">
      <a href={`/${lang}/archive/`}><strong>{c.entryArchive[0]}</strong><span>{c.entryArchive[1]}</span></a>
      <a href={`/${lang}/tags/`}><strong>{c.entryTags[0]}</strong><span>{c.entryTags[1]}</span></a>
      <a href={`/${lang}/rss.xml`}><strong>{c.entryRss[0]}</strong><span>{c.entryRss[1]}</span></a>
    </div>
  </section>

  <section class="measure measure--gallery band" aria-labelledby="colophon-title">
    <SectionMark label={c.colophonMark} aside={SITE.url.replace('https://', '')} />
    <h2 class="visually-hidden" id="colophon-title">{c.colophonMark}</h2>
    <div class="colophon">
      <div class="colophon__body">
        <h3>{c.aboutTitle}</h3>
        <p>{c.author}</p>
        <nav class="colophon__links" aria-label={c.about}>
          <a href={`/${lang}/about/`}>{c.about}</a>
          <a href="https://github.com/Morii9961" rel="me">GitHub</a>
          <a href={`/${lang}/rss.xml`}>RSS</a>
        </nav>
      </div>
      <div>
        <h3>{c.countsTitle}</h3>
        <dl class="colophon__counts">
          <div><dt>{c.posts}</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div>
          <div><dt>{c.categories}</dt><dd>{String(categories.length).padStart(2, '0')}</dd></div>
          <div><dt>{c.tags}</dt><dd>{String(tags.length).padStart(2, '0')}</dd></div>
          <div><dt>{c.languages}</dt><dd>{String(SITE.languages.length).padStart(2, '0')}</dd></div>
        </dl>
      </div>
      <div>
        <h3>{c.updatesTitle}</h3>
        <ol class="colophon__updates">
          {posts.slice(0, 4).map((post) => (
            <li>
              <a href={postPath(post)}>{post.data.title}</a>
              <time datetime={isoDay(post.data.publishedAt)}>{shortDate.format(post.data.publishedAt)}</time>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
