---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { getListedPosts, uniqueTaxonomy } from '../../../utils/content';

export function getStaticPaths() {
  return SITE.languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Language };
const ui = UI[lang];
const posts = await getListedPosts(lang);
const categories = uniqueTaxonomy(posts, 'category');
const categoryEntries = categories.map((name) => {
  const entries = posts.filter((post) => post.data.category === name);
  const latest = entries[0];
  if (!latest) throw new Error(`Category "${name}" has no listed posts.`);
  return { name, entries, latestTitle: latest.data.title };
});
const copy = {
  zh: {
    title: '分类', intro: '文章各有归处。更细的联系，留给标签。', categories: '分类', posts: '文章',
    entries: (count: number) => `${String(count).padStart(2, '0')} 篇`, latest: (title: string) => `最近一篇 · ${title}`,
    emptyTitle: '还没有分类', empty: '这个语言版本暂时没有可以公开列出的分类。',
    tags: '标签索引',
  },
  ja: {
    title: 'カテゴリー', intro: '記事にはそれぞれ主な置き場所があります。細かなつながりはタグに残します。', categories: 'カテゴリー', posts: '記事',
    entries: (count: number) => `${String(count).padStart(2, '0')} 件`, latest: (title: string) => `最新 · ${title}`,
    emptyTitle: 'カテゴリーはまだありません', empty: 'この言語で公開中のカテゴリーはまだありません。',
    tags: 'タグ索引',
  },
  en: {
    title: 'Categories', intro: 'Each post has a main place. Tags preserve the finer links.', categories: 'Categories', posts: 'Posts',
    entries: (count: number) => `${String(count).padStart(2, '0')} ${count === 1 ? 'post' : 'posts'}`, latest: (title: string) => `Latest · ${title}`,
    emptyTitle: 'No categories yet', empty: 'There are no public categories in this language yet.',
    tags: 'Tag index',
  },
} as const;
const c = copy[lang];
---

<BaseLayout lang={lang} title={c.title}>
  <div class="a-directory">
    <header class="a-directory__hero">
      <p class="prototype-kicker">Index / Categories</p>
      <div class="a-directory__title"><h1>{c.title}</h1><p>{c.intro}</p></div>
      <dl class="a-directory__stats">
        <div><dt>{c.categories}</dt><dd>{String(categoryEntries.length).padStart(2, '0')}</dd></div>
        <div><dt>{c.posts}</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div>
      </dl>
    </header>

    {categoryEntries.length > 0 ? (
      <nav class="a-category-directory" aria-label={ui.nav.categories}>
        {categoryEntries.map(({ name, entries, latestTitle }, index) => (
          <a href={`/${lang}/categories/${encodeURIComponent(name)}/`}>
            <span class="a-category-directory__number">{String(index + 1).padStart(2, '0')}</span>
            <div><h2>{name}</h2><p>{c.latest(latestTitle)}</p></div>
            <strong>{c.entries(entries.length)}</strong>
            <span class="a-category-directory__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    ) : (
      <section class="a-category-directory a-category-directory--quiet" aria-labelledby="categories-empty-title">
        <h2 id="categories-empty-title">{c.emptyTitle}</h2>
        <p>{c.empty}</p>
      </section>
    )}

    <p class="a-directory__crosslink"><a class="aperture-action" href={`/${lang}/tags/`}><span>{c.tags}</span><i aria-hidden="true">↗</i></a></p>
  </div>
</BaseLayout>
