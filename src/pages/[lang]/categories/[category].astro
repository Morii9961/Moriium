---
/*
 * One category, listed in the site's shared ledger so a filtered view reads
 * exactly like the unfiltered one.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostLedger from '../../../components/PostLedger.astro';
import SectionMark from '../../../components/SectionMark.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { formatDate, getListedPosts } from '../../../utils/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const lang of SITE.languages) {
    const posts = await getListedPosts(lang);
    for (const category of new Set(posts.map((post) => post.data.category))) {
      paths.push({ params: { lang, category }, props: { lang, category } });
    }
  }
  return paths;
};

const { lang, category } = Astro.props as { lang: Language; category: string };
const posts = (await getListedPosts(lang)).filter((post) => post.data.category === category);
const ui = UI[lang];
const latest = posts[0];
if (!latest) throw new Error(`Category "${category}" has no listed posts.`);

const copy = {
  zh: {
    mark: '分类', intro: `收在“${category}”下的文章，按发布时间从新到旧排列。`, posts: '篇数', updated: '最近更新',
    entries: (count: number) => `${String(count).padStart(2, '0')} 篇`, back: '← 返回全部分类',
  },
  ja: {
    mark: 'カテゴリー', intro: `「${category}」にまとめた記事を、公開日の新しい順に並べています。`, posts: '件数', updated: '最終更新',
    entries: (count: number) => `${String(count).padStart(2, '0')} 件`, back: '← カテゴリー一覧へ戻る',
  },
  en: {
    mark: 'Category', intro: `Posts filed under “${category}”, ordered from newest to oldest.`, posts: 'Posts', updated: 'Latest update',
    entries: (count: number) => `${String(count).padStart(2, '0')} ${count === 1 ? 'post' : 'posts'}`, back: '← Back to all categories',
  },
} as const;
const c = copy[lang];
---

<BaseLayout lang={lang} title={category}>
  <section class="measure measure--media page-head">
    <p class="page-head__eyebrow">{c.mark}</p>
    <h1>{category}</h1>
    <p class="page-head__lede">{c.intro}</p>
    <dl class="page-head__facts">
      <div><dt>{c.posts}</dt><dd>{c.entries(posts.length)}</dd></div>
      <div>
        <dt>{c.updated}</dt>
        <dd><time datetime={latest.data.publishedAt.toISOString()}>{formatDate(latest.data.publishedAt, ui.locale)}</time></dd>
      </div>
    </dl>
  </section>

  <section class="measure measure--media band" aria-labelledby="category-posts-title">
    <SectionMark label={category} aside={c.entries(posts.length)} lead />
    <h2 class="visually-hidden" id="category-posts-title">{category}</h2>
    <div class="band__body">
      <PostLedger posts={posts} lang={lang} showTags labelledBy="category-posts-title" />
    </div>
    <p class="crosslink"><a href={`/${lang}/categories/`}>{c.back}</a></p>
  </section>
</BaseLayout>
