---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TaxonomyPostList from '../../../components/TaxonomyPostList.astro';
import { SITE, UI, type Language } from '../../../data/site';
import { formatDate, getListedPosts } from '../../../utils/content';

export const getStaticPaths: GetStaticPaths = async () => {
  const paths = [];
  for (const lang of SITE.languages) {
    const posts = await getListedPosts(lang);
    for (const category of new Set(posts.map((post) => post.data.category))) {
      paths.push({ params: { lang, category }, props: { lang, category } });
    }
  }
  return paths;
};

const { lang, category } = Astro.props as { lang: Language; category: string };
const posts = (await getListedPosts(lang)).filter((post) => post.data.category === category);
const ui = UI[lang];
const latest = posts[0];
if (!latest) throw new Error(`Category "${category}" has no listed posts.`);

const copy = {
  zh: {
    kicker: 'Index / Category', intro: `收在“${category}”下的文章，按发布时间从新到旧排列。`, posts: '文章', updated: '最近更新',
    entries: (count: number) => `${String(count).padStart(2, '0')} 篇`, back: '返回全部分类 ←', tags: '标签',
  },
  ja: {
    kicker: 'Index / Category', intro: `「${category}」にまとめた記事を、公開日の新しい順に並べています。`, posts: '記事', updated: '最終更新',
    entries: (count: number) => `${String(count).padStart(2, '0')} 件`, back: 'カテゴリー一覧へ戻る ←', tags: 'タグ',
  },
  en: {
    kicker: 'Index / Category', intro: `Posts filed under “${category}”, ordered from newest to oldest.`, posts: 'Posts', updated: 'Latest update',
    entries: (count: number) => `${String(count).padStart(2, '0')} ${count === 1 ? 'post' : 'posts'}`, back: 'Back to all categories ←', tags: 'Tags',
  },
} as const;
const c = copy[lang];
---

<BaseLayout lang={lang} title={category}>
  <div class="a-directory">
    <header class="a-directory__hero">
      <p class="prototype-kicker">{c.kicker}</p>
      <div class="a-directory__title"><h1>{category}</h1><p>{c.intro}</p></div>
      <dl class="a-directory__stats">
        <div><dt>{c.posts}</dt><dd>{c.entries(posts.length)}</dd></div>
        <div><dt>{c.updated}</dt><dd><time datetime={latest.data.publishedAt.toISOString()}>{formatDate(latest.data.publishedAt, ui.locale)}</time></dd></div>
      </dl>
    </header>

    <TaxonomyPostList posts={posts} lang={lang} heading={category} countLabel={c.entries(posts.length)} tagsLabel={c.tags} />

    <p class="a-directory__crosslink"><a href={`/${lang}/categories/`}>{c.back}</a></p>
  </div>
</BaseLayout>
