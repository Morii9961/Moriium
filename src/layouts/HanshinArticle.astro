---
/**
 * Article frame for the 「版心」 design study.
 *
 * The reading row is one grid row shared by the outline and the prose, so the
 * outline can stand in the mat beside the text block and stay sticky for the
 * whole article. Below 1280 CSS pixels the mat has no room to hold it and the
 * outline returns to document order as a collapsed list.
 */
import type { CollectionEntry } from 'astro:content';
import HanshinBase from './HanshinBase.astro';
import ReaderEnhancements from '../components/ReaderEnhancements.astro';
import { SITE, UI, type Language } from '../data/site';
import { HANSHIN, hsDay, hsPath, hsReadingMinutes } from '../data/hanshin';
import { hsEntryHref } from '../utils/hanshin';
import type { ReaderFeatures } from '../utils/features';

type Post = CollectionEntry<'posts'>;
type Entry = CollectionEntry<'posts'> | CollectionEntry<'protected'>;
type Heading = { depth: number; slug: string; text: string };

interface Props {
  post: Post;
  translations: Entry[];
  features: ReaderFeatures;
  headings: Heading[];
  linkCategory: boolean;
  linkedTags: string[];
  previous?: Entry;
  next?: Entry;
}

const { post, translations, features, headings, linkCategory, linkedTags, previous, next } = Astro.props;
const lang = post.data.lang;
const c = HANSHIN[lang];
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = hsReadingMinutes(post.body ?? '');

const enabled = (Object.keys(features) as Array<keyof ReaderFeatures>)
  .filter((key) => features[key])
  .map((key) => c.feature[key]);

/* Translations are stated for every language, including the ones that do not
   exist yet. A missing version is shown as missing; it is never substituted. */
const translationStates = SITE.languages.map((code) => {
  const entry = translations.find((translation) => translation.data.lang === code);
  return { code, entry, current: code === lang };
});

const langHrefs = Object.fromEntries(
  translationStates
    .filter((state) => state.entry)
    .map((state) => [state.code, hsEntryHref(state.entry as Entry)]),
) as Partial<Record<Language, string>>;
---

<HanshinBase
  lang={lang}
  title={post.data.title}
  description={post.data.summary}
  ogType="article"
  langHrefs={langHrefs}
  {...(post.data.cover ? { image: post.data.cover } : {})}
>
  <article class="hs-flow hs-plate" data-copy-protection={String(features.copyProtection)}>
    <header class="hs-opening">
      <p class="hs-note hs-opening__label">
        <a href={hsPath(lang, 'writing')}>{c.nav.writing}</a>
        <span> / </span>
        {linkCategory ? (
          <a href={hsPath(lang, 'categories', post.data.category)}>{post.data.category}</a>
        ) : (
          <span>{post.data.category}</span>
        )}
      </p>
      <h1 class="hs-article__title">{post.data.title}</h1>
      <p class="hs-article__summary">{post.data.summary}</p>

      <dl class="hs-facts hs-note">
        <div>
          <dt>{c.published}</dt>
          <dd><time datetime={post.data.publishedAt.toISOString()}>{hsDay(post.data.publishedAt)}</time></dd>
        </div>
        {post.data.updatedAt && (
          <div>
            <dt>{c.updated}</dt>
            <dd><time datetime={post.data.updatedAt.toISOString()}>{hsDay(post.data.updatedAt)}</time></dd>
          </div>
        )}
        <div>
          <dt>{c.reading}</dt>
          <dd>{c.minutes(minutes)}</dd>
        </div>
        <div>
          <dt>{c.translations}</dt>
          <dd>
            {translationStates
              .filter((state) => state.entry || state.current)
              .map((state) => UI[state.code].label)
              .join(' · ')}
          </dd>
        </div>
      </dl>

      {outline.length > 0 && (
        <details class="hs-inline-toc hs-note">
          <summary>{c.outline}</summary>
          <ol>
            {outline.map((heading, index) => (
              <li>
                <a href={`#${heading.slug}`} data-depth={heading.depth}>
                  <span class="hs-num">{String(index + 1).padStart(2, '0')}</span> {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </header>

    {post.data.cover && (
      <figure class="hs-figure u-media">
        <img src={post.data.cover} alt={post.data.coverAlt ?? ''} />
        <figcaption class="hs-note">
          <span class="hs-note--latin">{c.cover}</span>
          <span>{post.data.coverAlt}</span>
        </figcaption>
      </figure>
    )}

    <div class="hs-reading">
      {outline.length > 0 && (
        <aside class="hs-margin-toc hs-note" aria-label={c.outline}>
          <p class="hs-note--loud">{c.outline}</p>
          <ol>
            {outline.map((heading) => (
              <li>
                <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}

      <div class="hs-prose article-body" id="article-body">
        <slot />
      </div>
    </div>

    <footer class="hs-end">
      {post.data.tags.length > 0 && (
        <div class="hs-end__block">
          <h2 class="hs-note hs-note--loud">{c.tags}</h2>
          <div class="hs-field">
            {post.data.tags.map((tag) => (
              linkedTags.includes(tag) ? (
                <a class="hs-note" href={hsPath(lang, 'tags', tag)}>#{tag}</a>
              ) : (
                <span class="hs-note">#{tag}</span>
              )
            ))}
          </div>
        </div>
      )}

      <div class="hs-end__block">
        <h2 class="hs-note hs-note--loud">{c.translations}</h2>
        <ul class="hs-translations hs-note">
          {translationStates.map((state) => (
            <li lang={UI[state.code].locale}>
              {state.current ? (
                <><strong>{UI[state.code].label}</strong><span>{c.current}</span></>
              ) : state.entry ? (
                <><a href={hsEntryHref(state.entry)}>{UI[state.code].label}</a><span>→</span></>
              ) : (
                <><span data-state="unavailable">{UI[state.code].label}</span><span>{c.unavailable}</span></>
              )}
            </li>
          ))}
        </ul>
      </div>

      <div class="hs-end__block">
        <h2 class="hs-note hs-note--loud">{c.readerFeatures}</h2>
        <p class="hs-note">{enabled.length > 0 ? enabled.join(' · ') : c.readerBasic}</p>
      </div>

      {(previous || next) && (
        <nav class="hs-adjacent" aria-label={`${c.previous} / ${c.next}`}>
          {previous && (
            <a href={hsEntryHref(previous)}>
              <span class="hs-note">← {c.previous}</span>
              <strong>{previous.data.title}</strong>
            </a>
          )}
          {next && (
            <a class="hs-adjacent--next" href={hsEntryHref(next)}>
              <span class="hs-note">{c.next} →</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )}

      <p class="hs-note"><a href={hsPath(lang, 'writing')}>{c.backToWriting}</a></p>
    </footer>
  </article>

  <ReaderEnhancements features={features} lang={lang} />
</HanshinBase>
