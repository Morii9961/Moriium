---
/*
 * The document shell for every public page.
 *
 * Three font families, matching the three roles DESIGN.md 5.1 defines: one
 * serif that draws Chinese, kana, and Latin from the same hand and therefore
 * carries reading and display in all three languages; one sans for navigation
 * and metadata; one monospace for code and figures. Nothing else is loaded.
 */
import '@fontsource-variable/noto-sans-sc/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import 'lxgw-wenkai-screen-webfont/lxgwwenkaigbscreen.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/content.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { SITE, UI, type Language } from '../data/site';

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  image?: string;
  bodyClass?: string;
  readingProgress?: boolean;
}

const {
  lang,
  title,
  description = UI[lang].description,
  canonical,
  noindex = false,
  ogType = 'website',
  image,
  bodyClass,
  readingProgress = false,
} = Astro.props;
const ui = UI[lang];
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const pathname = Astro.url.pathname;
const canonicalUrl = canonical ?? new URL(pathname, SITE.url).href;
const imageUrl = image ? new URL(image, SITE.url).href : undefined;
---

<!doctype html>
<html lang={ui.locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f2f5f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c14" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={`/${lang}/rss.xml`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{pageTitle}</title>
    <script is:inline src="/theme-init.js"></script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{ui.skip}</a>
    {readingProgress && <div class="reading-progress" aria-hidden="true"></div>}
    <SiteHeader lang={lang} pathname={pathname} />
    <SearchDialog lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const describeTheme = () => {
        if (!toggle) return;
        const dark = document.documentElement.dataset.theme === 'dark';
        toggle.setAttribute('aria-label', dark ? toggle.dataset.labelLight ?? '' : toggle.dataset.labelDark ?? '');
      };
      describeTheme();
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('moriium-theme', next);
        describeTheme();
        window.dispatchEvent(new CustomEvent('moriium:theme', { detail: next }));
      });

      const searchOpen = document.querySelector<HTMLButtonElement>('[data-search-open]');
      const searchDialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
      const showSearch = async () => {
        if (!searchDialog) return;
        const { openSearch } = await import('../scripts/search');
        await openSearch(searchDialog, searchOpen);
      };
      searchOpen?.addEventListener('click', showSearch);
      document.addEventListener('keydown', (event) => {
        const target = event.target;
        const editing =
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          (target instanceof HTMLElement && target.isContentEditable);
        if (
          editing ||
          event.altKey ||
          event.shiftKey ||
          event.key.toLocaleLowerCase() !== 'k' ||
          (!event.ctrlKey && !event.metaKey)
        ) {
          return;
        }
        event.preventDefault();
        void showSearch();
      });
    </script>
  </body>
</html>
