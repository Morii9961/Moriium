---
/*
 * The article page.
 *
 * DESIGN.md 6.1 asks an article to alternate widths rather than run one column
 * to the bottom, so the composition is: prose on the reading measure, the cover
 * photograph and any figure inside the body stepping out to the media measure,
 * and the closing navigation wider again. The outline lives in the right margin
 * on wide screens and becomes a jump strip above the article everywhere else,
 * so it never narrows the prose to make room for itself.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ReaderEnhancements from '../components/ReaderEnhancements.astro';
import SectionMark from '../components/SectionMark.astro';
import { SITE, UI, type Language } from '../data/site';
import { formatDate, postPath } from '../utils/content';
import type { ReaderFeatures } from '../utils/features';

type Post = CollectionEntry<'posts'>;
type Entry = CollectionEntry<'posts'> | CollectionEntry<'protected'>;
type Heading = { depth: number; slug: string; text: string };

interface Props {
  post: Post;
  translations: Entry[];
  features: ReaderFeatures;
  headings: Heading[];
  linkCategory: boolean;
  linkedTags: string[];
  previous?: Entry;
  next?: Entry;
}

const { post, translations, features, headings, linkCategory, linkedTags, previous, next } = Astro.props;
const lang = post.data.lang;
const ui = UI[lang];
const imageProps = post.data.cover ? { image: post.data.cover } : {};
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

// Chinese and Japanese are counted per character, Latin per word, because a
// single rate would misreport whichever language it was not tuned for.
const CJK = /[぀-ヿ㐀-鿿豈-﫿]/g;
const readingMinutes = (body: string) => {
  const cjk = body.match(CJK)?.length ?? 0;
  const words = body.replace(CJK, ' ').match(/[\p{L}\p{N}]+/gu)?.length ?? 0;
  return Math.max(1, Math.ceil(cjk / 400 + words / 220));
};

const copy = {
  zh: {
    home: '首页', writing: '文章', outline: '本文目录', published: '发布', updated: '更新',
    reading: '阅读', minutes: (count: number) => `${count} 分钟`, category: '分类', translations: '翻译',
    current: '当前版本', unavailable: '尚未提供', tags: '标签', reader: '阅读功能',
    colophon: 'Colophon', previous: '上一篇', next: '下一篇',
    basic: '本文只加载基础阅读样式。', loaded: (items: string[]) => `本文按需加载：${items.join('、')}。`,
    feature: { lightbox: '图片灯箱', mermaid: '图表', music: '音乐', video: '视频', math: '数学排版', copyProtection: '复制保护' },
    cover: '题图', openImage: '文章题图',
  },
  ja: {
    home: 'ホーム', writing: '記事', outline: '目次', published: '公開', updated: '更新',
    reading: '読了目安', minutes: (count: number) => `${count} 分`, category: 'カテゴリー', translations: '翻訳',
    current: '現在の版', unavailable: '未提供', tags: 'タグ', reader: '閲覧機能',
    colophon: 'Colophon', previous: '前の記事', next: '次の記事',
    basic: 'この記事は基本の閲覧スタイルだけを読み込みます。', loaded: (items: string[]) => `この記事では必要に応じて、${items.join('、')}を読み込みます。`,
    feature: { lightbox: '画像表示', mermaid: '図表', music: '音楽', video: '動画', math: '数式組版', copyProtection: 'コピー保護' },
    cover: 'カバー', openImage: '記事のカバー画像',
  },
  en: {
    home: 'Home', writing: 'Writing', outline: 'On this page', published: 'Published', updated: 'Updated',
    reading: 'Reading', minutes: (count: number) => `${count} min`, category: 'Category', translations: 'Translations',
    current: 'Current version', unavailable: 'Unavailable', tags: 'Tags', reader: 'Reader features',
    colophon: 'Colophon', previous: 'Previous', next: 'Next',
    basic: 'This post loads only the core reading styles.', loaded: (items: string[]) => `This post loads ${items.join(', ')} only when needed.`,
    feature: { lightbox: 'image lightbox', mermaid: 'diagrams', music: 'music', video: 'video', math: 'math typesetting', copyProtection: 'copy protection' },
    cover: 'Cover', openImage: 'Article cover image',
  },
} as const;
const c = copy[lang];
const enabledFeatures = (Object.keys(features) as Array<keyof ReaderFeatures>)
  .filter((key) => features[key])
  .map((key) => c.feature[key]);
const readerNote = enabledFeatures.length > 0 ? c.loaded(enabledFeatures) : c.basic;
const minutes = readingMinutes(post.body ?? '');
const categoryHref = `/${lang}/categories/${encodeURIComponent(post.data.category)}/`;
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.summary}
  ogType="article"
  readingProgress
  {...imageProps}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
    {post.data.updatedAt && <meta property="article:modified_time" content={post.data.updatedAt.toISOString()} />}
    {translations.map((entry) => (
      <link rel="alternate" hreflang={UI[entry.data.lang].locale} href={new URL(postPath(entry), Astro.site ?? SITE.url)} />
    ))}
  </Fragment>

  <article class="article" data-copy-protection={String(features.copyProtection)}>
    <header class="article__head measure measure--prose">
      <nav class="breadcrumb" aria-label={c.writing}>
        <a href={`/${lang}/`}>{c.home}</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <a href={`/${lang}/writing/`}>{c.writing}</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        {linkCategory ? <a href={categoryHref}>{post.data.category}</a> : <span>{post.data.category}</span>}
      </nav>
      <h1 class="article__title">{post.data.title}</h1>
      <p class="article__lede">{post.data.summary}</p>
      <dl class="article__facts">
        <div>
          <dt>{c.published}</dt>
          <dd><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, ui.locale)}</time></dd>
        </div>
        {post.data.updatedAt && (
          <div>
            <dt>{c.updated}</dt>
            <dd><time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt, ui.locale)}</time></dd>
          </div>
        )}
        <div>
          <dt>{c.reading}</dt>
          <dd>{c.minutes(minutes)}</dd>
        </div>
        <div>
          <dt>{c.category}</dt>
          <dd>{linkCategory ? <a href={categoryHref}>{post.data.category}</a> : post.data.category}</dd>
        </div>
      </dl>
    </header>

    {post.data.cover && (
      <figure class="plate article__cover measure measure--media">
        <img src={post.data.cover} alt={post.data.coverAlt ?? c.openImage} fetchpriority="high" decoding="async" />
        <figcaption>
          <span>{c.cover}</span>
          <span>{post.data.coverAlt}</span>
        </figcaption>
      </figure>
    )}

    <div class="article__reading">
      {outline.length > 0 && (
        <nav class="article__outline measure measure--prose" aria-labelledby="article-outline-title">
          <div class="article__outline-inner">
            <h2 id="article-outline-title">{c.outline}</h2>
            <ol>
              {outline.map((heading) => (
                <li data-depth={heading.depth}><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </div>
        </nav>
      )}

      <div class="article__body measure measure--prose" id="article-body">
        <div class="article-body">
          <slot />
        </div>
      </div>
    </div>

    <footer>
      <section class="article__colophon measure measure--prose" aria-labelledby="article-colophon-title">
        <SectionMark label={c.colophon} aside={post.data.category} />
        <h2 class="visually-hidden" id="article-colophon-title">{c.colophon}</h2>
        <div class="colophon-grid">
          <section aria-labelledby="article-translations-title">
            <h2 id="article-translations-title">{c.translations}</h2>
            <ul class="translation-list">
              {SITE.languages.map((code: Language) => {
                const entry = translations.find((translation) => translation.data.lang === code);
                const current = code === lang;
                return (
                  <li lang={UI[code].locale}>
                    {current
                      ? <strong>{UI[code].label}</strong>
                      : entry
                        ? <a href={postPath(entry)}>{UI[code].label}</a>
                        : <span>{UI[code].label}</span>}
                    <small>{current ? c.current : entry ? '↗' : c.unavailable}</small>
                  </li>
                );
              })}
            </ul>
          </section>
          <section aria-labelledby="article-tags-title">
            <h2 id="article-tags-title">{c.tags}</h2>
            <div class="tag-row">
              {post.data.tags.map((tag) =>
                linkedTags.includes(tag)
                  ? <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}># {tag}</a>
                  : <span># {tag}</span>,
              )}
            </div>
          </section>
          <section aria-labelledby="article-reader-title">
            <h2 id="article-reader-title">{c.reader}</h2>
            <p>{readerNote}</p>
          </section>
        </div>
      </section>

      {(previous || next) && (
        <nav class="adjacent measure measure--media" aria-label={`${c.previous} / ${c.next}`}>
          {previous && (
            <a href={postPath(previous)}>
              <span>{c.previous}</span>
              <strong>{previous.data.title}</strong>
            </a>
          )}
          {next && (
            <a class="adjacent__next" href={postPath(next)}>
              <span>{c.next}</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>
  <ReaderEnhancements features={features} lang={lang} />
</BaseLayout>
