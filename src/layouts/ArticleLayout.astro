---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ReaderEnhancements from '../components/ReaderEnhancements.astro';
import '../styles/public-reading.css';
import { SITE, UI, type Language } from '../data/site';
import { formatDate, postPath } from '../utils/content';
import type { ReaderFeatures } from '../utils/features';

type Post = CollectionEntry<'posts'>;
type Entry = CollectionEntry<'posts'> | CollectionEntry<'protected'>;
type Heading = { depth: number; slug: string; text: string };

interface Props {
  post: Post;
  translations: Entry[];
  features: ReaderFeatures;
  headings: Heading[];
  linkCategory: boolean;
  linkedTags: string[];
  previous?: Entry;
  next?: Entry;
}

const { post, translations, features, headings, linkCategory, linkedTags, previous, next } = Astro.props;
const lang = post.data.lang;
const ui = UI[lang];
const imageProps = post.data.cover ? { image: post.data.cover } : {};
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const readingMinutes = (body: string) => {
  const cjk = body.match(/[\u3040-\u30ff\u3400-\u9fff\uf900-\ufaff]/g)?.length ?? 0;
  const words = body.replace(/[\u3040-\u30ff\u3400-\u9fff\uf900-\ufaff]/g, ' ').match(/[\p{L}\p{N}]+/gu)?.length ?? 0;
  return Math.max(1, Math.ceil(cjk / 400 + words / 220));
};

const copy = {
  zh: {
    home: '首页', writing: '文章', outline: '本文目录', back: '← 返回文章列表', published: '发布', updated: '更新',
    reading: '阅读', minutes: (count: number) => `${count} 分钟`, category: '分类', translations: '翻译', current: '当前版本',
    unavailable: '尚未提供', tags: '标签', reader: '阅读提示', end: 'End', previous: '上一篇', next: '下一篇',
    basic: '本文只加载基础阅读样式。', loaded: (items: string[]) => `本文按需加载：${items.join('、')}。`,
    feature: { lightbox: '图片灯箱', mermaid: '图表', music: '音乐', video: '视频', math: '数学排版', copyProtection: '复制保护' },
    cover: '题图', openImage: '文章题图',
  },
  ja: {
    home: 'ホーム', writing: '記事', outline: '目次', back: '← 記事一覧へ戻る', published: '公開', updated: '更新',
    reading: '読了目安', minutes: (count: number) => `${count} 分`, category: 'カテゴリー', translations: '翻訳', current: '現在の版',
    unavailable: '未提供', tags: 'タグ', reader: '閲覧機能', end: 'End', previous: '前の記事', next: '次の記事',
    basic: 'この記事は基本の閲覧スタイルだけを読み込みます。', loaded: (items: string[]) => `この記事では必要に応じて、${items.join('、')}を読み込みます。`,
    feature: { lightbox: '画像表示', mermaid: '図表', music: '音楽', video: '動画', math: '数式組版', copyProtection: 'コピー保護' },
    cover: 'カバー', openImage: '記事のカバー画像',
  },
  en: {
    home: 'Home', writing: 'Writing', outline: 'On this page', back: '← Back to all writing', published: 'Published', updated: 'Updated',
    reading: 'Reading', minutes: (count: number) => `${count} min`, category: 'Category', translations: 'Translations', current: 'Current version',
    unavailable: 'Unavailable', tags: 'Tags', reader: 'Reader features', end: 'End', previous: 'Previous', next: 'Next',
    basic: 'This post loads only the core reading styles.', loaded: (items: string[]) => `This post loads ${items.join(', ')} only when needed.`,
    feature: { lightbox: 'image lightbox', mermaid: 'diagrams', music: 'music', video: 'video', math: 'math typesetting', copyProtection: 'copy protection' },
    cover: 'Cover', openImage: 'Article cover image',
  },
} as const;
const c = copy[lang];
const enabledFeatures = (Object.keys(features) as Array<keyof ReaderFeatures>)
  .filter((key) => features[key])
  .map((key) => c.feature[key]);
const readerNote = enabledFeatures.length > 0 ? c.loaded(enabledFeatures) : c.basic;
const minutes = readingMinutes(post.body ?? '');
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.summary} ogType="article" {...imageProps}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
    {post.data.updatedAt && <meta property="article:modified_time" content={post.data.updatedAt.toISOString()} />}
    {translations.map((entry) => (
      <link rel="alternate" hreflang={UI[entry.data.lang].locale} href={new URL(postPath(entry), Astro.site ?? SITE.url)} />
    ))}
  </Fragment>

  <article class="a-article" data-copy-protection={String(features.copyProtection)}>
    <header class="a-article__hero">
      <p class="a-article__breadcrumb">
        <a href={`/${lang}/`}>{c.home}</a><span>/</span>
        <a href={`/${lang}/writing/`}>{c.writing}</a><span>/</span>
        {linkCategory ? <a href={`/${lang}/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a> : <span>{post.data.category}</span>}
      </p>
      <div class="a-article__title">
        <p class="prototype-kicker">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="prototype-article__lead">{post.data.summary}</p>
      </div>
      <dl class="a-article__facts">
        <div><dt>{c.published}</dt><dd><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, ui.locale)}</time></dd></div>
        {post.data.updatedAt && <div><dt>{c.updated}</dt><dd><time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt, ui.locale)}</time></dd></div>}
        <div><dt>{c.reading}</dt><dd>{c.minutes(minutes)}</dd></div>
        <div><dt>{c.category}</dt><dd>{linkCategory ? <a href={`/${lang}/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a> : post.data.category}</dd></div>
      </dl>
    </header>

    {post.data.cover && (
      <figure class="a-article__cover">
        <img src={post.data.cover} alt={post.data.coverAlt ?? c.openImage} />
        <figcaption><span>{c.cover}</span><span>{post.data.coverAlt}</span></figcaption>
      </figure>
    )}

    <div class="a-reading-grid" id="article-body">
      <aside class="a-article__outline">
        <p>{c.outline}</p>
        {outline.length > 0 && (
          <nav aria-label={c.outline}>
            {outline.map((heading, index) => (
              <a href={`#${heading.slug}`} data-depth={heading.depth}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a>
            ))}
          </nav>
        )}
        <a class="a-article__back" href={`/${lang}/writing/`}>{c.back}</a>
      </aside>

      <div class="prototype-article__body article-body a-article__body">
        <slot />
      </div>

      <aside class="a-article__context" aria-label={`${c.translations} / ${c.tags}`}>
        <section>
          <p>{c.translations}</p>
          <ul>
            {SITE.languages.map((code: Language) => {
              const entry = translations.find((translation) => translation.data.lang === code);
              const current = code === lang;
              return (
                <li lang={UI[code].locale}>
                  {current ? <strong>{UI[code].label}</strong> : entry ? <a href={postPath(entry)}>{UI[code].label}</a> : <span>{UI[code].label}</span>}
                  <small>{current ? c.current : entry ? '↗' : c.unavailable}</small>
                </li>
              );
            })}
          </ul>
        </section>
        <section>
          <p>{c.tags}</p>
          <div>{post.data.tags.map((tag) => linkedTags.includes(tag) ? <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}># {tag}</a> : <span># {tag}</span>)}</div>
        </section>
        <section>
          <p>{c.reader}</p>
          <span>{readerNote}</span>
        </section>
      </aside>
    </div>

    <footer class="a-article__end">
      <p>{c.end} / {post.data.title}</p>
      {(previous || next) && (
        <nav aria-label={`${c.previous} / ${c.next}`}>
          {previous && <a href={postPath(previous)}><span>{c.previous}</span><strong>{previous.data.title}</strong></a>}
          {next && <a class="a-article__next" href={postPath(next)}><span>{c.next}</span><strong>{next.data.title}</strong></a>}
        </nav>
      )}
    </footer>
  </article>
  <ReaderEnhancements features={features} lang={lang} />
</BaseLayout>
