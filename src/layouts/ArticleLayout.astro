---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ReaderEnhancements from '../components/ReaderEnhancements.astro';
import '../styles/public-reading.css';
import { SITE, UI } from '../data/site';
import { formatDate, postPath } from '../utils/content';
import type { ReaderFeatures } from '../utils/features';

type Post = CollectionEntry<'posts'>;
type Entry = CollectionEntry<'posts'> | CollectionEntry<'protected'>;
type Heading = { depth: number; slug: string; text: string };

interface Props {
  post: Post;
  translations: Entry[];
  features: ReaderFeatures;
  headings: Heading[];
  linkCategory: boolean;
  linkedTags: string[];
  previous?: Entry;
  next?: Entry;
}

const { post, translations, features, headings, linkCategory, linkedTags, previous, next } = Astro.props;
const lang = post.data.lang;
const ui = UI[lang];
const imageProps = post.data.cover ? { image: post.data.cover } : {};
// remark puts a visually hidden `Footnotes` heading above the note list, and it
// carries an id like any other, so it arrives in `headings` and would otherwise
// be listed in the outline as a section of the article.
const outline = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label',
);

// What a reader reads is prose. Counting the raw source charged them for code
// fences, Mermaid definitions, KaTeX source, directive attributes and URLs, all
// of which arrive on the page as something other than words — on the capability
// article that roughly doubled the estimate.
const readingMinutes = (body: string) => {
  const prose = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/~~~[\s\S]*?~~~/g, ' ')
    .replace(/\$\$[\s\S]*?\$\$/g, ' ')
    .replace(/`[^`]*`/g, ' ')
    .replace(/\$[^$\n]*\$/g, ' ')
    .replace(/^:::.*$/gm, ' ')
    .replace(/::\w+\{[^}]*\}/g, ' ')
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/https?:\/\/\S+/g, ' ');
  const cjk = prose.match(/[\u3040-\u30ff\u3400-\u9fff\uf900-\ufaff]/g)?.length ?? 0;
  const words = prose.replace(/[\u3040-\u30ff\u3400-\u9fff\uf900-\ufaff]/g, ' ').match(/[\p{L}\p{N}]+/gu)?.length ?? 0;
  return Math.max(1, Math.ceil(cjk / 400 + words / 220));
};

const copy = {
  zh: {
    home: '首页', writing: '文章', breadcrumb: '面包屑导航', outline: '目录', back: '← 文章索引',
    published: '发布', updated: '更新', reading: '阅读时间', minutes: (count: number) => `约 ${count} 分钟`,
    category: '分类', tags: '标签', previous: '上一篇', next: '下一篇', adjacent: '上一篇与下一篇',
    cover: '题图', openImage: '文章题图',
  },
  ja: {
    home: 'ホーム', writing: '記事', breadcrumb: 'パンくずリスト', outline: '目次', back: '← 記事索引',
    published: '公開', updated: '更新', reading: '読了目安', minutes: (count: number) => `約 ${count} 分`,
    category: 'カテゴリー', tags: 'タグ', previous: '前の記事', next: '次の記事', adjacent: '前後の記事',
    cover: 'カバー', openImage: '記事のカバー画像',
  },
  en: {
    home: 'Home', writing: 'Writing', breadcrumb: 'Breadcrumb', outline: 'Contents', back: '← Writing index',
    published: 'Published', updated: 'Updated', reading: 'Reading time', minutes: (count: number) => `About ${count} min`,
    category: 'Category', tags: 'Tags', previous: 'Previous', next: 'Next', adjacent: 'Previous and next post',
    cover: 'Cover', openImage: 'Article cover image',
  },
} as const;
const c = copy[lang];
const minutes = readingMinutes(post.body ?? '');
const categoryHref = `/${lang}/categories/${encodeURIComponent(post.data.category)}/`;

// schema.org BlogPosting. Static text, no request, no reader identity — it
// describes the article to aggregators and search, and is not analytics.
const articleUrl = new URL(postPath(post), Astro.site ?? SITE.url).href;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  inLanguage: ui.locale,
  datePublished: post.data.publishedAt.toISOString(),
  ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
  ...(post.data.cover ? { image: new URL(post.data.cover, Astro.site ?? SITE.url).href } : {}),
  articleSection: post.data.category,
  ...(post.data.tags.length > 0 ? { keywords: post.data.tags.join(', ') } : {}),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  url: articleUrl,
  // `<` is the only character that can close the surrounding script element.
}).replaceAll('<', '\\u003c');
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.summary} ogType="article" {...imageProps}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
    {post.data.updatedAt && <meta property="article:modified_time" content={post.data.updatedAt.toISOString()} />}
    {/* The visible language list is gone from the page, but the relationship
        between the three variants still has to be declared. */}
    {translations.map((entry) => (
      <link rel="alternate" hreflang={UI[entry.data.lang].locale} href={new URL(postPath(entry), Astro.site ?? SITE.url)} />
    ))}
    <script type="application/ld+json" is:inline set:html={structuredData} />
  </Fragment>

  <article class="a-article" data-copy-protection={String(features.copyProtection)}>
    <header class="a-article__hero">
      <nav class="a-article__breadcrumb" aria-label={c.breadcrumb}>
        <ol>
          <li><a href={`/${lang}/`}>{c.home}</a></li>
          <li><a href={`/${lang}/writing/`}>{c.writing}</a></li>
          <li>{linkCategory ? <a href={categoryHref}>{post.data.category}</a> : post.data.category}</li>
        </ol>
      </nav>
      <div class="a-article__title">
        <h1 lang={ui.locale}>{post.data.title}</h1>
        <p class="a-article__lead">{post.data.summary}</p>
      </div>
      <dl class="a-article__facts">
        <div><dt>{c.published}</dt><dd><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, ui.locale)}</time></dd></div>
        {post.data.updatedAt && <div><dt>{c.updated}</dt><dd><time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt, ui.locale)}</time></dd></div>}
        <div><dt>{c.reading}</dt><dd>{c.minutes(minutes)}</dd></div>
        <div><dt>{c.category}</dt><dd>{linkCategory ? <a href={categoryHref}>{post.data.category}</a> : post.data.category}</dd></div>
      </dl>
    </header>

    {post.data.cover && (
      <figure class="a-article__cover">
        <img src={post.data.cover} alt={post.data.coverAlt ?? c.openImage} />
        <figcaption><span>{c.cover}</span><span>{post.data.coverAlt}</span></figcaption>
      </figure>
    )}

    <div class="a-reading-grid">
      {/* A short post has no sections, and a label standing over an empty rail
          announces a table of contents that is not there. */}
      <aside class="a-article__outline" data-article-outline>
        {outline.length > 0 && (
          <>
            <p>{c.outline}</p>
            <nav aria-label={c.outline}>
              {outline.map((heading, index) => (
                <a href={`#${heading.slug}`} data-depth={heading.depth}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a>
              ))}
            </nav>
          </>
        )}
        <a class="a-article__back" href={`/${lang}/writing/`}>{c.back}</a>
      </aside>

      <div class="article-body a-article__body" id="article-body">
        <slot />
      </div>
    </div>

    {(post.data.tags.length > 0 || previous || next) && (
    <footer class="a-article__end">
      {post.data.tags.length > 0 && (
        <div class="a-article__tags">
          <p>{c.tags}</p>
          {post.data.tags.map((tag) => linkedTags.includes(tag)
            ? <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}># {tag}</a>
            : <span># {tag}</span>)}
        </div>
      )}
      {(previous || next) && (
        <nav aria-label={c.adjacent}>
          {previous && <a href={postPath(previous)}><span>{c.previous}</span><strong>{previous.data.title}</strong></a>}
          {next && <a class="a-article__next" href={postPath(next)}><span>{c.next}</span><strong>{next.data.title}</strong></a>}
        </nav>
      )}
    </footer>
    )}
  </article>
  <ReaderEnhancements features={features} lang={lang} />

  <script>
    // Marks the section the reader is currently in. Without this module the
    // outline is still a list of working anchor links, which is all it was
    // before; the only thing added is knowing where you are.
    const outline = document.querySelector<HTMLElement>('[data-article-outline] nav');
    const body = document.getElementById('article-body');

    if (outline && body) {
      const links = new Map<string, HTMLAnchorElement>();
      for (const link of outline.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
        links.set(decodeURIComponent(link.hash.slice(1)), link);
      }

      let current: HTMLAnchorElement | null = null;
      const setCurrent = (link: HTMLAnchorElement) => {
        if (link === current) return;
        current?.removeAttribute('aria-current');
        link.setAttribute('aria-current', 'true');
        current = link;
      };

      // A heading only intersects while it is on screen, so asking "which
      // heading is visible" leaves the rail blank through every long section.
      // Ask instead which heading governs the block that is in the band: walk
      // back through the preceding siblings until one is a heading.
      const governing = (element: Element) => {
        let node: Element | null = element;
        while (node) {
          if (node.matches('h2[id], h3[id]')) return node;
          node = node.previousElementSibling;
        }
        return null;
      };

      const blocks = [...body.children];
      let observer: IntersectionObserver | undefined;

      // A band a little below the top of the viewport, deep enough to catch the
      // largest gap between two blocks. Everything above it has been read.
      const connect = () => {
        const top = 80;
        const bottom = top + 56;
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const heading = governing(entry.target);
              const link = heading && links.get(heading.id);
              if (link) {
                setCurrent(link);
                break;
              }
            }
          },
          { rootMargin: `-${top}px 0% ${bottom - document.documentElement.clientHeight}px` },
        );
        for (const block of blocks) observer.observe(block);
      };

      connect();

      let resizing: number | undefined;
      window.addEventListener('resize', () => {
        observer?.disconnect();
        observer = undefined;
        window.clearTimeout(resizing);
        resizing = window.setTimeout(connect, 200);
      });
    }
  </script>
</BaseLayout>
