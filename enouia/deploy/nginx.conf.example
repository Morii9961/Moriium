# Separate virtual host. Replace the example domain and paths before activation.
# Complete TLS using the server's existing certificate workflow before public use.
# Never point this root at the repository checkout or the Moriium release root.
server {
    listen 80;
    listen [::]:80;
    server_name enouia.example.com;
    root /var/www/enouia/current;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    location / {
        try_files $uri $uri/ =404;
    }
    location = /index.html {
        expires -1;
    }
    location /_astro/ {
        expires 1y;
    }
    location /images/ {
        expires 1h;
    }
    location ~ /\. {
        deny all;
    }
}
