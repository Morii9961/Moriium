# Optional at build time. The cache task falls back to repository links when absent.
GITHUB_TOKEN=

# VPS deployment values are configured as GitHub Actions secrets, never committed.
VPS_HOST=
VPS_USER=
VPS_SSH_KEY=
VPS_RELEASE_ROOT=/var/www/moriium

# Author admin runtime data. Production keeps all three outside releases/,
# which are replaced whole and pruned to six (ADR 0002 section 15.1).
MORIIUM_DATABASE_PATH=/var/lib/moriium/admin.db
MORIIUM_SESSION_DIRECTORY=/var/lib/moriium/sessions
# Sanitized public derivatives. The export copies them into the built site;
# nothing here is served to a reader directly.
MORIIUM_MEDIA_ROOT=/var/lib/moriium/media
# Where scripts/export-content.mjs writes the published articles and the media
# manifest. The build copies `current/` from here into its workspace, so this
# directory is build input and must survive a release being replaced.
MORIIUM_CONTENT_ROOT=/var/lib/moriium/content

# scripts/release-site.mjs. The release root holds workspace/, releases/ and the
# current symlink; the probe URL is what the release asks after switching, and a
# release that cannot reach it restores the previous one instead of going live.
MORIIUM_RELEASE_ROOT=/var/www/moriium
MORIIUM_PROBE_URL=https://morii9961.top/zh/
