{
  "name": "moriium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.22 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync": "astro sync",
    "check": "astro check",
    "content:validate": "node scripts/validate-content.mjs",
    "media:check": "node scripts/check-media.mjs",
    "audit:public": "node scripts/audit-public-tree.mjs",
    "design:fonts": "node scripts/audit-design-fonts.mjs",
    "github:cache": "node scripts/cache-github.mjs",
    "encrypt": "node scripts/encrypt-post.mjs",
    "account:create": "node scripts/create-author-account.mjs create",
    "account:disable": "node scripts/create-author-account.mjs disable",
    "content:export": "node scripts/export-content.mjs",
    "content:migrate-fixtures": "node scripts/import-fixture-content.mjs",
    "site:release": "node scripts/release-site.mjs",
    "build": "node scripts/validate-content.mjs && node scripts/check-media.mjs && node scripts/cache-github.mjs && astro build --force",
    "test": "node --test tests/*.test.mjs",
    "links": "node scripts/check-links.mjs",
    "split": "node scripts/check-render-split.mjs",
    "baseline": "node scripts/measure-baseline.mjs",
    "verify": "astro check && node scripts/validate-content.mjs && node scripts/check-media.mjs && node scripts/cache-github.mjs && astro build --force && node --test tests/*.test.mjs && node scripts/check-links.mjs && node scripts/audit-public-tree.mjs && node scripts/check-render-split.mjs && node scripts/measure-baseline.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/node": "11.1.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@expressive-code/plugin-collapsible-sections": "0.44.1",
    "@expressive-code/plugin-line-numbers": "0.44.1",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tiptap/core": "3.30.5",
    "@tiptap/markdown": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/vue-3": "3.30.5",
    "astro": "7.2.4",
    "astro-expressive-code": "0.44.1",
    "katex": "0.18.4",
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "marked": "17.0.6",
    "mermaid": "11.17.2",
    "photoswipe": "5.4.4",
    "rehype-expressive-code": "0.44.1",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "sharp": "0.35.3",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.4.0",
    "picomatch": "4.0.7",
    "typescript": "6.0.3"
  }
}
